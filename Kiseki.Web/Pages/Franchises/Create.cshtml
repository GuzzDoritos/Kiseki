@page
@model Kiseki.Web.Pages.Franchises.CreateModel
@{
    ViewData["Title"] = "Create franchise";
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Franchises/Index">Franchises</a><span>/</span><span>Create</span>
</nav>

<div class="page-header compact">
    <div>
        <p class="eyebrow">Organization</p>
        <h1>Create franchise</h1>
        <p class="page-description">Group related series across media lines while keeping media units separate.</p>
    </div>
</div>

<section class="content-card form-card">
    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="form-error-summary mb-3" role="alert"></div>

        <div class="form-stack">
            <div>
                <label class="form-label" asp-for="Input.Title">Title</label>
                <input class="form-control" asp-for="Input.Title" placeholder="e.g. Re:Zero" autofocus />
                <span asp-validation-for="Input.Title" class="form-field-error"></span>
            </div>
            <div>
                <label class="form-label" asp-for="Input.JitenAnchorDeckId">Jiten anchor deck ID (optional)</label>
                <input class="form-control" asp-for="Input.JitenAnchorDeckId" type="number" min="1" placeholder="e.g. 10" />
                <span asp-validation-for="Input.JitenAnchorDeckId" class="form-field-error"></span>
                <small class="text-muted d-block mt-1">An optional Jiten deck ID to anchor graph discovery across connected media decks.</small>
            </div>
        </div>
        <div class="form-actions mt-4">
            <button class="btn btn-primary" type="submit">Create franchise</button>
            <a class="btn btn-link" asp-page="/Franchises/Index">Cancel</a>
        </div>
    </form>
</section>

