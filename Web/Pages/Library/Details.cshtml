@page "{id:guid}"
@model Web.Pages.Library.DetailsModel
@{
    ViewData["Title"] = "Work details";
    var emptyProgress = new ProgressBarViewModel(0, 0, "No character total yet");
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Library/Index">Library</a>
    <span>/</span>
    <span>Work details</span>
</nav>

<div class="page-header">
    <div>
        <span class="media-badge media-badge-book">Book</span>
        <h1>Media work</h1>
        <p class="page-description">Work ID: @Model.Id</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Library/Edit" asp-route-id="@Model.Id">Edit</a>
</div>

<div class="detail-grid">
    <section class="content-card detail-primary">
        <p class="eyebrow">Progress</p>
        <h2>Reading progress</h2>
        <partial name="_ProgressBar" model="emptyProgress" />
    </section>

    <aside class="content-card detail-aside">
        <p class="eyebrow">Organization</p>
        <dl class="metadata-list">
            <div><dt>Series</dt><dd>Unassigned</dd></div>
            <div><dt>Jiten</dt><dd>Not linked</dd></div>
            <div><dt>Status</dt><dd>In progress</dd></div>
        </dl>
    </aside>
</div>

<section class="content-card section-block">
    <div class="section-heading">
        <div><p class="eyebrow">History</p><h2>Immersion sessions</h2></div>
    </div>
    <div class="inline-empty">Session history will appear here after Core is connected.</div>
</section>
