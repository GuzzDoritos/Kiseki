@page
@model Kiseki.Web.Pages.IndexModel
@{
ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
    </div>
    <a class="btn btn-primary" asp-page="/Import/Index">Add media</a>
</div>

<partial name="_Heatmap" model="Model" />

<partial name="_ReadingVolumeChart" />

<section class="stat-grid" aria-label="Immersion summary">
    <article class="stat-card">
        <span class="stat-label">Characters this week</span>
        <strong>@Model.WeekCount</strong>
    </article>
    <article class="stat-card">
        <span class="stat-label">Time this week</span>
        <strong>@Model.WeekTime</strong>
    </article>
    <article class="stat-card">
        <span class="stat-label">Characters this year</span>
        <strong>@Model.YearCount</strong>
    </article>
    <article class="stat-card">
        <span class="stat-label">Time this year</span>
        <strong>@Model.YearTime</strong>
    </article>
    <article class="stat-card">
        <span class="stat-label">Active works</span>
        <strong>@Model.ActiveWorksCount</strong>
    </article>
</section>
<link rel="stylesheet" href="~/css/uPlot.min.css" />

@section Scripts {
    <script src="~/js/uPlot.iife.min.js"></script>
    <script type="module" src="~/js/heatmap.js" asp-append-version="true"></script>
    <script type="module" src="~/js/reading-volume.js" asp-append-version="true"></script>
}
