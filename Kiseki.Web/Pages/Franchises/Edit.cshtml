@page "{id:guid}"
@model Kiseki.Web.Pages.Franchises.EditModel
@{
    ViewData["Title"] = "Edit franchise";
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Franchises/Index">Franchises</a><span>/</span>
    <a asp-page="/Franchises/Details" asp-route-id="@Model.Id">Franchise details</a><span>/</span><span>Edit</span>
</nav>

<div class="page-header compact">
    <div>
        <p class="eyebrow">Organization</p>
        <h1>Edit franchise</h1>
        <p class="page-description">Update franchise details or remove the franchise container.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="page-error" role="alert">@Model.Error</div>
}

<section class="content-card form-card mb-4">
    <form method="post" asp-page-handler="Edit" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="form-error-summary mb-3" role="alert"></div>

        <div class="form-stack">
            <div>
                <label class="form-label" asp-for="Input.Title">Title</label>
                <input class="form-control" asp-for="Input.Title" autofocus />
                <span asp-validation-for="Input.Title" class="form-field-error"></span>
            </div>
            <div>
                <label class="form-label" asp-for="Input.JitenAnchorDeckId">Jiten anchor deck ID (optional)</label>
                <input class="form-control" asp-for="Input.JitenAnchorDeckId" type="number" min="1" />
                <span asp-validation-for="Input.JitenAnchorDeckId" class="form-field-error"></span>
                <small class="text-muted d-block mt-1">An optional Jiten deck ID to anchor graph discovery across connected media decks.</small>
            </div>
        </div>
        <div class="form-actions mt-4">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-link" asp-page="/Franchises/Details" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </form>
</section>

<section class="content-card form-card border-danger">
    <h2 class="h5 text-danger mb-2">Delete franchise</h2>
    <p class="text-muted small mb-3">
        Deleting this franchise removes only the grouping container. All member series, installments, tracked copies, and immersion histories remain intact and will become standalone series.
    </p>
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Are you sure you want to delete this franchise? Member series will not be deleted.');">
        @Html.AntiForgeryToken()
        <button class="btn btn-danger" type="submit">Delete franchise</button>
    </form>
</section>

