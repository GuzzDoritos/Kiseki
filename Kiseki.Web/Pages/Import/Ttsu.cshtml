@page
@model Kiseki.Web.Pages.Import.TtsuModel
@{
    ViewData["Title"] = "Import from Ttsu";
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Import/Index">Import</a><span>/</span><span>Ttsu</span>
</nav>

<div class="page-header compact">
    <div>
        <p class="eyebrow">Reading history</p>
        <h1>Import from Ttsu</h1>
        <p class="page-description">Preview detected works before adding anything to the library.</p>
    </div>
</div>

<section class="content-card empty-state upload-state">
    <div class="empty-icon">⇧</div>
    <h2>Ttsu importer scaffold</h2>
    <p>The existing Core loader will be exposed here in the next implementation step.</p>
    <button class="btn btn-primary" type="button" disabled>Load Ttsu data</button>
</section>
