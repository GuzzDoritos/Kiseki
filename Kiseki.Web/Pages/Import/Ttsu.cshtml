@page
@model Kiseki.Web.Pages.Import.TtsuModel
@using Kiseki.Core.Models
@using Kiseki.Web.Models
@{
    ViewData["Title"] = "Import from TTSU";
}
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Import/Index">Import</a><span>/</span><span>TTSU</span>
</nav>
<div class="page-header compact">
    <div>
        <p class="eyebrow">Reading history</p>
        <h1>Import or update from TTSU</h1>
        <p class="page-description">Choose your TTSU folder and review changes to your daily totals. Dates missing from the export are kept.</p>
    </div>
</div>
<div asp-validation-summary="All" class="import-validation" role="alert"></div>
@if (Model.Warnings.Count > 0)
{
    <aside class="import-warnings" aria-label="Import warnings">
        <strong>Some files need attention</strong>
        <ul>@foreach (var warning in Model.Warnings) { <li>@warning</li> }</ul>
    </aside>
}
<section class="content-card ttsu-upload-card">
    <form method="post" enctype="multipart/form-data" asp-page-handler="Preview">
        <div class="ttsu-folder-picker">
            <svg class="ttsu-upload-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M3.5 7.5h6l1.8 2h9.2v8.75A2.25 2.25 0 0 1 18.25 20H5.75a2.25 2.25 0 0 1-2.25-2.25V7.5Z"></path><path d="M12 16V6m-3 3 3-3 3 3"></path></svg>
            <div class="ttsu-picker-copy"><strong>Select your TTSU data folder</strong><span data-ttsu-selection-summary>Statistics, progress, and cover files will be processed.</span></div>
            <input class="visually-hidden" asp-for="FolderFiles" type="file" webkitdirectory multiple data-ttsu-folder-input />
            <label class="btn btn-outline-secondary" asp-for="FolderFiles">Choose folder</label>
        </div>
        <div class="form-check ttsu-auto-match-option">
            <input class="form-check-input" type="checkbox" asp-for="AutoMatchMetadata" data-ttsu-auto-match />
            <label class="form-check-label" asp-for="AutoMatchMetadata">
                Auto-match metadata with Jiten
            </label>
            <span class="form-text d-block">Search Jiten.moe for matching titles and volume numbers to suggest book covers and character counts.</span>
        </div>
        <div class="form-actions"><button class="btn btn-primary" type="submit">Preview books</button></div>
    </form>
</section>
@if (Model.HasPreview)
{
    <section class="ttsu-preview" aria-labelledby="ttsu-preview-title">
        <div class="ttsu-preview-heading"><h2 id="ttsu-preview-title">Review @Model.Books.Count @(Model.Books.Count == 1 ? "book" : "books")</h2><span>Nothing has been saved yet</span></div>
        <p>After changing a target or resolving a day, select <strong>Refresh review</strong> to see the resulting totals before confirming. Deselect any books you want to skip.</p>

        @if (Model.IsEnrichmentActive)
        {
            <noscript>
                <div class="alert alert-warning import-noscript-warning" role="alert">
                    Automatic metadata matching requires JavaScript. Reading history import remains fully usable below without automatic metadata.
                </div>
            </noscript>
            <div class="content-card ttsu-enrichment-progress-card" data-ttsu-auto-match-progress data-batch-id="@Model.BatchId" data-total="@Model.EnrichmentTotalCount" data-completed="@Model.EnrichmentCompletedCount">
                <div class="ttsu-enrichment-progress-header">
                    <div class="ttsu-enrichment-spinner" data-ttsu-progress-spinner aria-hidden="true"></div>
                    <div>
                        <h3 class="ttsu-enrichment-title">Matching book metadata and covers</h3>
                        <p class="ttsu-progress-status" data-ttsu-progress-status>Looking up metadata and covers — @Model.EnrichmentCompletedCount of @Model.EnrichmentTotalCount books checked</p>
                        <p class="ttsu-progress-summary" data-ttsu-progress-summary>Looking up metadata and covers — @Model.EnrichmentCompletedCount of @Model.EnrichmentTotalCount books checked</p>
                        <p class="ttsu-progress-current-title text-muted text-truncate" data-ttsu-progress-current-title style="font-size: 0.85em; margin-top: 2px; max-width: 400px;"></p>
                    </div>
                </div>
                <div class="progress ttsu-progress-bar-container">
                    <div class="progress-bar ttsu-progress-bar-fill"
                         role="progressbar"
                         aria-label="Metadata matching progress"
                         aria-valuemin="0"
                         aria-valuemax="@Model.EnrichmentTotalCount"
                         aria-valuenow="@Model.EnrichmentCompletedCount"
                         style="width: @(Model.EnrichmentTotalCount > 0 ? (Model.EnrichmentCompletedCount * 100.0 / Model.EnrichmentTotalCount).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "0")%"
                         data-ttsu-progress-bar>
                    </div>
                </div>
                <p class="ttsu-progress-secondary" data-ttsu-progress-secondary>Searching Jiten, Google Books, and Open Library. Keep this page open.</p>
                <div class="visually-hidden" aria-live="polite" aria-atomic="true" data-ttsu-progress-live>Checked @Model.EnrichmentCompletedCount of @Model.EnrichmentTotalCount books</div>
                <div class="ttsu-progress-error-container" data-ttsu-progress-error hidden>
                    <p class="import-warnings text-danger" data-ttsu-progress-error-message></p>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-ttsu-progress-resume>Resume lookup</button>
                </div>
            </div>
        }

        @if (!Model.IsGoogleBooksConfigured)
        {
            <aside class="ttsu-google-unconfigured-note" aria-label="Google Books notice">
                Google Books cover lookup is unconfigured. Set <code>GoogleBooks:ApiKey</code> to enable automatic per-volume covers.
            </aside>
        }

        <form method="post" asp-page-handler="Confirm" id="ttsuReviewForm">
            <input type="hidden" asp-for="BatchId" />
            <div class="ttsu-book-list">
            @for (var index = 0; index < Model.Books.Count; index++)
            {
                var book = Model.Books[index];
                var plan = book.Plan;
                var targetReview = plan.TargetReview;
                var currentIntent = Model.Selections[index].CopyIntent;
                var currentTargetId = Model.Selections[index].TargetId;
                var currentInstallmentId = Model.Selections[index].InstallmentId;

                string? suggestedTargetTitle = null;
                if (targetReview?.SuggestedChoice is { } suggestedChoice)
                {
                    if (suggestedChoice.Intent == TtsuCopyIntent.ExistingCopy && suggestedChoice.WorkId is Guid workId)
                    {
                        suggestedTargetTitle = Model.Targets.FirstOrDefault(t => t.Id == workId)?.Title
                            ?? targetReview.CopyCandidates.FirstOrDefault(c => c.WorkId == workId)?.Title;
                    }
                    else if (suggestedChoice.Intent == TtsuCopyIntent.NewCopyUnderExistingInstallment && suggestedChoice.InstallmentId is Guid instId)
                    {
                        suggestedTargetTitle = Model.InstallmentTargets.FirstOrDefault(i => i.Id == instId)?.Title
                            ?? targetReview.InstallmentCandidates.FirstOrDefault(i => i.InstallmentId == instId)?.Title;
                    }
                }
                <article class="content-card ttsu-book-preview">
                    <input type="hidden" asp-for="Selections[index].BookKey" />
                    <input type="hidden" asp-for="Selections[index].ReviewToken" />
                    <div class="ttsu-book-select"><input class="form-check-input" asp-for="Selections[index].Selected" aria-label="Select @book.Title" /></div>
                    <div class="ttsu-book-copy">
                        <div style="display: flex; gap: 12px; align-items: flex-start;">
                            @if (!string.IsNullOrWhiteSpace(book.CoverUrl))
                            {
                                <div class="candidate-thumb-frame has-image" style="width: 44px; height: 62px; flex-shrink: 0;">
                                    <img src="@book.CoverUrl" alt="Cover for @book.Title" loading="lazy" class="candidate-thumb" />
                                </div>
                            }
                            <div style="min-width: 0; flex: 1;">
                                <h3>@book.Title</h3><p>@book.FolderHint</p>
                                <div class="ttsu-match-badges">
                                    <span class="import-match">@book.MatchReason</span>
                                    @if (!string.IsNullOrWhiteSpace(book.CoverUrl))
                                    {
                                        <span class="import-badge import-badge-automatched">Folder cover</span>
                                    }
                                    @if (book.Enrichment is not null)
                                    {
                                        <span class="import-badge import-badge-@book.Enrichment.Badge.ToString().ToLowerInvariant()">@book.Enrichment.BadgeLabel</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="ttsu-import-mode ttsu-target-selection" data-ttsu-target-selection data-book-index="@index">
                        <input type="hidden" asp-for="Selections[index].Mode" id="mode_input_@index" data-ttsu-mode-input />

                        <fieldset class="ttsu-target-fieldset" aria-labelledby="target_legend_@index">
                            <legend class="ttsu-target-legend" id="target_legend_@index">
                                <span>Target installment &amp; copy</span>
                            </legend>

                            @if (targetReview?.IsAmbiguous == true)
                            {
                                <div class="ttsu-target-callout ttsu-target-ambiguous" role="alert" aria-live="polite">
                                    <div class="ttsu-callout-header">
                                        <svg class="ttsu-callout-icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
                                            <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
                                        </svg>
                                        <strong>Ambiguous target</strong>
                                    </div>
                                    <p class="ttsu-callout-text">@targetReview.Reason</p>
                                    <p class="ttsu-callout-hint">Choose an existing copy or catalogue installment below, then click <strong>Refresh review</strong>.</p>
                                </div>
                            }
                            else if (targetReview?.SuggestedChoice is not null)
                            {
                                <div class="ttsu-target-callout ttsu-target-suggested">
                                    <span class="ttsu-badge ttsu-badge-suggested">Suggested</span>
                                    <span class="ttsu-suggested-text">
                                        @if (targetReview.SuggestedChoice.Intent == TtsuCopyIntent.NewCopyUnderExistingInstallment && !string.IsNullOrWhiteSpace(suggestedTargetTitle))
                                        {
                                            <strong>New copy under @suggestedTargetTitle</strong>
                                        }
                                        else if (targetReview.SuggestedChoice.Intent == TtsuCopyIntent.ExistingCopy && !string.IsNullOrWhiteSpace(suggestedTargetTitle))
                                        {
                                            <strong>Update @suggestedTargetTitle</strong>
                                        }
                                        else if (targetReview.SuggestedChoice.Intent == TtsuCopyIntent.NewInstallmentAndCopy)
                                        {
                                            <strong>New standalone installment &amp; copy</strong>
                                        }
                                        — @targetReview.Reason
                                    </span>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(targetReview?.Reason))
                            {
                                <div class="ttsu-target-callout ttsu-target-info">
                                    <span class="ttsu-suggested-text">@targetReview.Reason</span>
                                </div>
                            }

                            <div class="ttsu-intent-options" role="radiogroup" aria-labelledby="target_legend_@index">
                                <!-- Option 1: Existing copy -->
                                <div class="ttsu-intent-option @(currentIntent == TtsuCopyIntent.ExistingCopy ? "is-selected" : "")" data-ttsu-option-card="ExistingCopy">
                                    <div class="form-check ttsu-intent-radio-wrap">
                                        <input class="form-check-input" type="radio"
                                               name="Selections[@index].CopyIntent"
                                               id="intent_existing_@index"
                                               value="@TtsuCopyIntent.ExistingCopy"
                                               @(currentIntent == TtsuCopyIntent.ExistingCopy ? "checked" : "")
                                               data-ttsu-intent-radio
                                               data-intent="ExistingCopy"
                                               data-index="@index"
                                               aria-describedby="intent_existing_desc_@index" />
                                        <label class="form-check-label ttsu-intent-label" for="intent_existing_@index">
                                            <span class="ttsu-intent-title">Update existing copy</span>
                                            <span class="ttsu-intent-desc" id="intent_existing_desc_@index">Merge reading sessions into an existing tracked book in your library.</span>
                                        </label>
                                    </div>
                                    <div class="ttsu-intent-dropdown-wrap" id="wrap_existing_@index" style="@(currentIntent == TtsuCopyIntent.ExistingCopy ? "" : "display: none;")">
                                        <label for="select_target_@index" class="form-label">Existing book to update</label>
                                        <select class="form-select" id="select_target_@index" name="Selections[@index].TargetId" data-ttsu-target-select data-index="@index"
                                                disabled="@(currentIntent != TtsuCopyIntent.ExistingCopy ? "disabled" : null)">
                                            <option value="">Choose an existing copy...</option>
                                            @foreach (var target in Model.Targets)
                                            {
                                                var candidate = targetReview?.CopyCandidates.FirstOrDefault(c => c.WorkId == target.Id);
                                                var isSelected = currentTargetId == target.Id;
                                                string optionText;
                                                if (candidate is not null)
                                                {
                                                    if (candidate.HasBinding && !candidate.BindingMatchesSource)
                                                    {
                                                        optionText = $"{target.Title} — {candidate.LifetimeCharacters:N0} chars (Bound to another source — conflict)";
                                                    }
                                                    else if (candidate.HasBinding)
                                                    {
                                                        optionText = $"{target.Title} — {candidate.LifetimeCharacters:N0} chars (Bound to this source)";
                                                    }
                                                    else
                                                    {
                                                        optionText = $"{target.Title} — {candidate.LifetimeCharacters:N0} chars (Unbound)";
                                                    }
                                                }
                                                else
                                                {
                                                    optionText = $"{target.Title} ({target.Id.ToString()[..8]})";
                                                }
                                                <option value="@target.Id" selected="@(isSelected ? "selected" : null)">@optionText</option>
                                            }
                                        </select>
                                        @if (targetReview?.CopyCandidates.Count > 0)
                                        {
                                            <div class="ttsu-candidate-breakdown">
                                                <span class="ttsu-candidate-label">Detected copies:</span>
                                                <ul class="ttsu-candidate-chips">
                                                    @foreach (var cand in targetReview.CopyCandidates)
                                                    {
                                                        <li class="ttsu-candidate-chip @(cand.HasBinding && !cand.BindingMatchesSource ? "chip-conflict" : "")">
                                                            <span class="chip-title">@cand.Title</span>
                                                            <span class="chip-chars">@cand.LifetimeCharacters.ToString("N0") chars</span>
                                                            @if (cand.HasBinding && !cand.BindingMatchesSource)
                                                            {
                                                                <span class="ttsu-badge ttsu-badge-conflict">Bound to another source (conflict)</span>
                                                            }
                                                            else if (cand.HasBinding)
                                                            {
                                                                <span class="ttsu-badge ttsu-badge-bound">Bound to this source</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="ttsu-badge ttsu-badge-unbound">Unbound</span>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Option 2: New copy under existing catalogue installment -->
                                <div class="ttsu-intent-option @(currentIntent == TtsuCopyIntent.NewCopyUnderExistingInstallment ? "is-selected" : "")" data-ttsu-option-card="NewCopyUnderExistingInstallment">
                                    <div class="form-check ttsu-intent-radio-wrap">
                                        <input class="form-check-input" type="radio"
                                               name="Selections[@index].CopyIntent"
                                               id="intent_newcopy_@index"
                                               value="@TtsuCopyIntent.NewCopyUnderExistingInstallment"
                                               @(currentIntent == TtsuCopyIntent.NewCopyUnderExistingInstallment ? "checked" : "")
                                               data-ttsu-intent-radio
                                               data-intent="NewCopyUnderExistingInstallment"
                                               data-index="@index"
                                               aria-describedby="intent_newcopy_desc_@index" />
                                        <label class="form-check-label ttsu-intent-label" for="intent_newcopy_@index">
                                            <span class="ttsu-intent-title">New copy under existing installment</span>
                                            <span class="ttsu-intent-desc" id="intent_newcopy_desc_@index">Track a separate edition or reread under an existing catalogue volume.</span>
                                        </label>
                                    </div>
                                    <div class="ttsu-intent-dropdown-wrap" id="wrap_newcopy_@index" style="@(currentIntent == TtsuCopyIntent.NewCopyUnderExistingInstallment ? "" : "display: none;")">
                                        <label for="select_installment_@index" class="form-label">Catalogue installment</label>
                                        <select class="form-select" id="select_installment_@index" name="Selections[@index].InstallmentId" data-ttsu-installment-select data-index="@index"
                                                disabled="@(currentIntent != TtsuCopyIntent.NewCopyUnderExistingInstallment ? "disabled" : null)">
                                            <option value="">Choose a catalogue installment...</option>
                                            @foreach (var inst in Model.InstallmentTargets)
                                            {
                                                var candidate = targetReview?.InstallmentCandidates.FirstOrDefault(i => i.InstallmentId == inst.Id);
                                                var isSelected = currentInstallmentId == inst.Id;
                                                string optionText;
                                                if (candidate is not null)
                                                {
                                                    var countLabel = candidate.CopyCount == 0 ? "Catalogue only (0 copies)" : $"{candidate.CopyCount} copies ({candidate.UnboundCopyCount} unbound)";
                                                    var prov = candidate.ProviderKeys.Count > 0 ? $" [{string.Join(", ", candidate.ProviderKeys)}]" : "";
                                                    optionText = $"{inst.Title} — {countLabel}{prov}";
                                                }
                                                else
                                                {
                                                    var countLabel = inst.CopyCount == 0 ? "Catalogue only (0 copies)" : $"{inst.CopyCount} copies";
                                                    optionText = $"{inst.Title} — {countLabel}";
                                                }
                                                <option value="@inst.Id" selected="@(isSelected ? "selected" : null)">@optionText</option>
                                            }
                                        </select>
                                        @if (targetReview?.InstallmentCandidates.Count > 0)
                                        {
                                            <div class="ttsu-candidate-breakdown">
                                                <span class="ttsu-candidate-label">Matched catalogue installments:</span>
                                                <ul class="ttsu-candidate-chips">
                                                    @foreach (var instCand in targetReview.InstallmentCandidates)
                                                    {
                                                        <li class="ttsu-candidate-chip">
                                                            <span class="chip-title">@instCand.Title</span>
                                                            @if (instCand.CopyCount == 0)
                                                            {
                                                                <span class="ttsu-badge ttsu-badge-catalogue-only">Catalogue only (0 copies)</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="ttsu-badge ttsu-badge-tracked">@instCand.CopyCount @(instCand.CopyCount == 1 ? "copy" : "copies")</span>
                                                            }
                                                            @if (instCand.ProviderKeys.Count > 0)
                                                            {
                                                                <span class="chip-prov">@string.Join(", ", instCand.ProviderKeys)</span>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Option 3: New installment and copy -->
                                <div class="ttsu-intent-option @(currentIntent == TtsuCopyIntent.NewInstallmentAndCopy ? "is-selected" : "")" data-ttsu-option-card="NewInstallmentAndCopy">
                                    <div class="form-check ttsu-intent-radio-wrap">
                                        <input class="form-check-input" type="radio"
                                               name="Selections[@index].CopyIntent"
                                               id="intent_newinst_@index"
                                               value="@TtsuCopyIntent.NewInstallmentAndCopy"
                                               @(currentIntent == TtsuCopyIntent.NewInstallmentAndCopy ? "checked" : "")
                                               data-ttsu-intent-radio
                                               data-intent="NewInstallmentAndCopy"
                                               data-index="@index"
                                               aria-describedby="intent_newinst_desc_@index" />
                                        <label class="form-check-label ttsu-intent-label" for="intent_newinst_@index">
                                            <span class="ttsu-intent-title">New installment &amp; copy</span>
                                            <span class="ttsu-intent-desc" id="intent_newinst_desc_@index">Creates a new standalone installment and copy in your library.</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    @if (plan.Error is not null) { <p class="import-warnings">@plan.Error</p> }
                    <dl class="ttsu-book-stats">
                        <div><dt>New days</dt><dd>@plan.Count(TtsuDayAction.Added)</dd></div>
                        <div><dt>Updated</dt><dd>@plan.Count(TtsuDayAction.Updated)</dd></div>
                        <div><dt>Unchanged</dt><dd>@plan.Count(TtsuDayAction.Unchanged)</dd></div>
                        <div><dt>Older skipped</dt><dd>@plan.Count(TtsuDayAction.Stale)</dd></div>
                        <div><dt>Needs review</dt><dd>@plan.Count(TtsuDayAction.Conflict)</dd></div>
                    </dl>
                    @if (plan.Progress.Existing is not null || plan.Progress.Incoming.Count > 0)
                    {
                        <div class="ttsu-merge-totals">
                            <strong>TTSU reading position</strong>
                            <p>Status: @plan.Progress.Action</p>
                            @if (book.CurrentPosition is int position && book.PositionPercentage is double percentage)
                            {
                                <p>Position: @position.ToString("N0") characters (@percentage.ToString("N2")%)</p>
                            }
                            @if (plan.Progress.ResultingTotalCharacters is int inferredTotal)
                            {
                                <p>Inferred book total: @inferredTotal.ToString("N0") characters</p>
                            }
                            else
                            {
                                <p>The bookmark does not contain a precise ratio from which a total can be inferred.</p>
                            }
                        </div>
                        @if (plan.Progress.ReviewReason is not null)
                        {
                            <div class="ttsu-day-resolution">
                                <label asp-for="Selections[index].ProgressChoice">@plan.Progress.ReviewReason</label>
                                <select class="form-select" asp-for="Selections[index].ProgressChoice">
                                    <option value="">Choose the progress state to keep</option>
                                    @if (plan.Progress.Existing is { } existingProgress)
                                    {
                                        <option value="keep">Keep stored: @existingProgress.CharacterPosition.ToString("N0") characters / @((existingProgress.ProgressFraction * 100).ToString("N2"))%</option>
                                    }
                                    @for (var progressIndex = 0; progressIndex < plan.Progress.Incoming.Count; progressIndex++)
                                    {
                                        var incomingProgress = plan.Progress.Incoming[progressIndex];
                                        <option value="incoming:@progressIndex">Use incoming: @incomingProgress.CharacterPosition.ToString("N0") characters / @((incomingProgress.ProgressFraction * 100).ToString("N2"))% (revision @(incomingProgress.Revision?.ToString() ?? "unknown"))</option>
                                    }
                                </select>
                            </div>
                        }
                    }
                    <div class="ttsu-merge-totals">
                        <strong>@plan.TargetTitle</strong>
                        <p>Characters: @plan.CurrentCharacters.ToString("N0") → @plan.ResultCharacters.ToString("N0") (@((plan.ResultCharacters - plan.CurrentCharacters).ToString("+0;-0;0")))</p>
                        <p>Reading time: @TtsuBookPreviewViewModel.FormatDuration(plan.CurrentMinutes * 60) → @TtsuBookPreviewViewModel.FormatDuration(plan.ResultMinutes * 60)</p>
                        @if (!plan.CanApply) { <p>Totals are provisional until all selected conflicts are resolved.</p> }
                    </div>
                    @if (book.Enrichment is not null)
                    {
                        var enrichment = book.Enrichment;
                        <div class="ttsu-enrichment-section">
                            <div class="ttsu-enrichment-header">
                                <strong>Metadata suggestions</strong>
                                <span class="import-badge import-badge-@enrichment.Badge.ToString().ToLowerInvariant()">@enrichment.BadgeLabel</span>
                            </div>
                            @if (!enrichment.IsMetadataApplicationEligible && enrichment.IneligibilityReason is not null)
                            {
                                <p class="import-warnings">@enrichment.IneligibilityReason</p>
                            }
                            @if (enrichment.FilteredIncompatibleCount > 0)
                            {
                                <p class="filtered-incompatible-summary">
                                    @(enrichment.FilteredIncompatibleCount == 1 ? "1 incompatible volume was ignored." : $"{enrichment.FilteredIncompatibleCount} other volumes were ignored.")
                                </p>
                            }
                            @if (enrichment.Warnings.Count > 0)
                            {
                                <ul class="enrichment-warnings">
                                    @foreach (var warning in enrichment.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            }
                            @if (enrichment.Evidence.Count > 0)
                            {
                                <p class="enrichment-evidence">Evidence: @string.Join(" • ", enrichment.Evidence)</p>
                            }
                            <div class="ttsu-candidate-choices">
                                <div class="form-check ttsu-candidate-option">
                                    <input class="form-check-input" type="radio"
                                           name="Selections[@index].CandidateKey"
                                           id="candidate_none_@index"
                                           value=""
                                           @(enrichment.SelectedCandidateKey == null ? "checked" : "") />
                                    <label class="form-check-label" for="candidate_none_@index">
                                        Import without Jiten metadata
                                    </label>
                                </div>
                                @foreach (var candidate in enrichment.Candidates)
                                {
                                    var inputId = $"candidate_{candidate.Key}_{index}";
                                    var isSelected = enrichment.SelectedCandidateKey == candidate.Key;
                                    <div class="form-check ttsu-candidate-option candidate-card @(isSelected ? "candidate-selected" : "")">
                                        <input class="form-check-input" type="radio"
                                               name="Selections[@index].CandidateKey"
                                               id="@inputId"
                                               value="@candidate.Key"
                                               @(isSelected ? "checked" : "")
                                               @(enrichment.IsMetadataApplicationEligible && candidate.IsSelectable ? "" : "disabled") />
                                        <label class="form-check-label candidate-label" for="@inputId">
                                            <div class="candidate-thumb-frame @(string.IsNullOrWhiteSpace(candidate.CoverUrl) ? "" : "has-image")" data-cover-frame>
                                                @if (!string.IsNullOrWhiteSpace(candidate.CoverUrl))
                                                {
                                                    <img src="@candidate.CoverUrl" alt="Cover for @candidate.DisplayTitle" loading="lazy" referrerpolicy="no-referrer" data-cover-image class="candidate-thumb" />
                                                    <span class="candidate-thumb-placeholder" data-cover-fallback hidden aria-hidden="true">本</span>
                                                }
                                                else
                                                {
                                                    <span class="candidate-thumb-placeholder" data-cover-fallback aria-hidden="true">本</span>
                                                }
                                            </div>
                                            <div class="candidate-info">
                                                <div class="candidate-title-row">
                                                    <span class="candidate-title">@candidate.DisplayTitle</span>
                                                    @if (candidate.IsTopCandidate)
                                                    {
                                                        <span class="badge-top-candidate">Top match</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(candidate.RomajiTitle) && candidate.RomajiTitle != candidate.DisplayTitle)
                                                {
                                                    <span class="candidate-subtitle">@candidate.RomajiTitle</span>
                                                }
                                                <div class="candidate-meta">
                                                    <span>@(candidate.SubdeckId.HasValue ? $"Subdeck {candidate.SubdeckId} (Deck {candidate.DeckId})" : $"Deck {candidate.DeckId}")</span>
                                                    <span>@candidate.CharacterCount.ToString("N0") characters</span>
                                                    <span>@candidate.Score pts</span>
                                                    <span class="candidate-cover-label">@candidate.CoverEvidenceLabel</span>
                                                    @if (!string.IsNullOrWhiteSpace(candidate.CoverDimensionsLabel))
                                                    {
                                                        <span class="candidate-cover-dimensions">@candidate.CoverDimensionsLabel</span>
                                                    }
                                                    @if (candidate.IsGoogleLowResolution)
                                                    {
                                                        <span class="badge-low-resolution">Low resolution</span>
                                                    }
                                                    @if (candidate.CoverProvider == Kiseki.Core.Models.Covers.ExternalCoverProvider.OpenLibrary && !string.IsNullOrWhiteSpace(candidate.GoogleVolumeId))
                                                    {
                                                        <span class="open-library-preview-item" style="display: inline-flex; align-items: center; gap: 4px; margin-left: 6px;">
                                                            <a href="@(candidate.GoogleAttributionLink ?? $"https://openlibrary.org/isbn/{candidate.GoogleVolumeId}")"
                                                               target="_blank"
                                                               rel="noopener noreferrer"
                                                               class="text-decoration-none"
                                                               onclick="event.stopPropagation();"
                                                               style="font-size: 0.85em;">
                                                                Open Library
                                                            </a>
                                                        </span>
                                                    }
                                                    else if (candidate.HasGoogleCover && !string.IsNullOrWhiteSpace(candidate.GoogleVolumeId))
                                                    {
                                                        <span class="google-books-preview-item" style="display: inline-flex; align-items: center; gap: 4px; margin-left: 6px;">
                                                            <a href="@(candidate.GoogleAttributionLink ?? $"https://books.google.com/books?id={candidate.GoogleVolumeId}")"
                                                               target="_blank"
                                                               rel="noopener noreferrer"
                                                               class="text-decoration-none"
                                                               onclick="event.stopPropagation();"
                                                               style="font-size: 0.85em;">
                                                                Google Books
                                                            </a>
                                                            <img src="https://books.google.com/googlebooks/images/poweredby.png"
                                                                 alt="Powered by Google"
                                                                 loading="lazy"
                                                                 referrerpolicy="no-referrer"
                                                                 style="height: 12px; width: auto; vertical-align: middle;" />
                                                        </span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(candidate.GoogleStatusMessage))
                                                {
                                                    <span class="candidate-google-status">@candidate.GoogleStatusMessage</span>
                                                }
                                                @if (candidate.CoverOptions is { Count: > 1 } editionOptions)
                                                {
                                                    <details class="candidate-edition-options-details" style="margin-top: 8px;" onclick="event.stopPropagation();">
                                                        <summary style="font-size: 0.85em; cursor: pointer; color: var(--color-primary, #6ea8fe);">Choose cover edition (@editionOptions.Count editions available)</summary>
                                                        <div class="edition-options-list" style="margin-top: 6px; display: flex; flex-direction: column; gap: 6px;">
                                                            @foreach (var opt in editionOptions)
                                                            {
                                                                var optId = $"edition_{opt.SelectionKey}_{index}";
                                                                var isOptChecked = opt.SelectionKey == candidate.SelectedCoverKey;
                                                                <div class="form-check" style="font-size: 0.85em;">
                                                                    <input class="form-check-input" type="radio"
                                                                           name="Selections[@index].SelectedCoverKey"
                                                                           id="@optId"
                                                                           value="@opt.SelectionKey"
                                                                           @(isOptChecked ? "checked" : "") />
                                                                    <label class="form-check-label" for="@optId">
                                                                        <span class="badge bg-secondary">@(opt.Provider == Kiseki.Core.Models.Covers.ExternalCoverProvider.OpenLibrary ? "Open Library" : "Google Books")</span>
                                                                        <span>@opt.Width×@opt.Height</span>
                                                                        @if (opt.IsLowResolution)
                                                                        {
                                                                            <span class="badge-low-resolution">Low resolution</span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(opt.PublishedDate))
                                                                        {
                                                                            <span class="text-muted">(@opt.PublishedDate)</span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(opt.NormalizedIsbn))
                                                                        {
                                                                            <span class="text-muted">ISBN: @opt.NormalizedIsbn</span>
                                                                        }
                                                                    </label>
                                                                </div>
                                                            }
                                                            <div class="form-check" style="font-size: 0.85em;">
                                                                <input class="form-check-input" type="radio"
                                                                       name="Selections[@index].SelectedCoverKey"
                                                                       id="edition_none_@index"
                                                                       value="none"
                                                                       @(candidate.SelectedCoverKey == "none" ? "checked" : "") />
                                                                <label class="form-check-label text-muted" for="edition_none_@index">
                                                                    Use no external cover
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </details>
                                                }
                                                @if (candidate.IsLowConfidence)
                                                {
                                                    <p class="candidate-low-confidence-warning">Not safe to choose automatically. Verify the title and volume before selecting.</p>
                                                }
                                                @if (candidate.IsDisqualified && !string.IsNullOrWhiteSpace(candidate.DisqualificationReason))
                                                {
                                                    <p class="candidate-disqualified-reason">@candidate.DisqualificationReason</p>
                                                }
                                                @if (candidate.Evidence.Count > 0)
                                                {
                                                    <details class="candidate-evidence-details">
                                                        <summary>Why this matched</summary>
                                                        <ul class="candidate-evidence">
                                                            @foreach (var evidence in candidate.Evidence)
                                                            {
                                                                <li>@evidence</li>
                                                            }
                                                        </ul>
                                                    </details>
                                                }
                                            </div>
                                        </label>
                                    </div>
                                }
                            </div>
                            @if (enrichment.OmittedPlausibleCount > 0)
                            {
                                <p class="omitted-plausible-summary">
                                    @(enrichment.OmittedPlausibleCount == 1 ? "1 additional same-volume candidate was omitted; link manually after import if none of these is correct." : $"{enrichment.OmittedPlausibleCount} additional same-volume candidates were omitted; link manually after import if none of these is correct.")
                                </p>
                            }
                        </div>
                    }
                    <details class="ttsu-entry-details" open="@(plan.Days.Any(day => day.ReviewReason is not null))">
                        <summary>Review daily changes</summary>
                        <div class="ttsu-entry-table-wrap">
                            <table class="ttsu-entry-table">
                                <thead><tr><th>Date</th><th>Current characters / time</th><th>Incoming characters / time</th><th>Result</th></tr></thead>
                                <tbody>
                                @foreach (var day in plan.Days)
                                {
                                    <tr>
                                        <td>@day.Date.ToString("yyyy-MM-dd")</td>
                                        <td>@foreach (var old in day.Existing) { <div>@old.Characters.ToString("N0") / @TtsuBookPreviewViewModel.FormatDuration(old.Minutes * 60)</div> }</td>
                                        <td>@foreach (var incoming in day.Incoming) { <div>@incoming.Characters.ToString("N0") / @TtsuBookPreviewViewModel.FormatDuration(incoming.Minutes * 60)</div> }</td>
                                        <td>@day.Action</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        @for (var dayIndex = 0; dayIndex < Model.Selections[index].Days.Count; dayIndex++)
                        {
                            var day = plan.Days.Single(x => x.Date == Model.Selections[index].Days[dayIndex].Date);
                            <div class="ttsu-day-resolution">
                                <input type="hidden" asp-for="Selections[index].Days[dayIndex].Date" />
                                <label asp-for="Selections[index].Days[dayIndex].Choice">@day.Date.ToString("yyyy-MM-dd"): @day.ReviewReason</label>
                                <select class="form-select" asp-for="Selections[index].Days[dayIndex].Choice">
                                    <option value="">Choose the total to keep</option>
                                    @foreach (var old in day.Existing) { <option value="keep:@old.Id">Keep stored: @old.Characters characters / @TtsuBookPreviewViewModel.FormatDuration(old.Minutes * 60) (revision @(old.Revision?.ToString() ?? "unknown"))</option> }
                                    @for (var candidate = 0; candidate < day.Incoming.Count; candidate++)
                                    {
                                        var incoming = day.Incoming[candidate];
                                        <option value="incoming:@candidate">Use incoming baseline: @incoming.Characters characters / @TtsuBookPreviewViewModel.FormatDuration(incoming.Minutes * 60) (revision @(incoming.Revision?.ToString() ?? "unknown"))</option>
                                    }
                                </select>
                            </div>
                        }
                    </details>
                    @if (Model.Orphans.Count > 0)
                    {
                        <details class="ttsu-entry-details">
                            <summary>Assign unassigned TTSU logs to this existing book</summary>
                            <label asp-for="Selections[index].OrphanLogIds">Select only logs belonging to this book. Leave others unselected.</label>
                            <select multiple class="form-select" asp-for="Selections[index].OrphanLogIds">
                                @foreach (var orphan in Model.Orphans) { <option value="@orphan.Id">@orphan.Date.ToString("yyyy-MM-dd") — @orphan.Characters chars / @TtsuBookPreviewViewModel.FormatDuration(orphan.Minutes * 60) (@orphan.Id.ToString()[..8])</option> }
                            </select>
                        </details>
                    }
                </article>
            }
            </div>
            @{
                var hasBlockingErrors = Model.Books.Where((b, i) => i < Model.Selections.Count && Model.Selections[i].Selected).Any(b => !b.Plan.CanApply);
                var hasSelected = Model.Selections.Any(s => s.Selected);
                var canConfirm = !Model.IsEnrichmentActive && hasSelected && !hasBlockingErrors;
            }
            <div class="form-actions ttsu-confirm-actions">
                <button class="btn btn-outline-secondary" type="submit" asp-page-handler="Review" data-ttsu-action-btn data-ttsu-review-btn disabled="@(Model.IsEnrichmentActive ? "disabled" : null)">Refresh review</button>
                <button class="btn btn-primary" type="submit" data-ttsu-action-btn data-ttsu-confirm-btn disabled="@(!canConfirm ? "disabled" : null)">Confirm selected books</button>
                <button class="btn btn-outline-secondary" type="submit" asp-page-handler="Cancel" formnovalidate>Cancel</button>
                <span class="ttsu-confirm-hint text-warning" data-ttsu-confirm-hint role="status" style="@(hasBlockingErrors ? "" : "display: none;")">Some selections require review or have unresolved conflicts. Select <strong>Refresh review</strong> before confirming.</span>
            </div>
        </form>
    </section>
}
