@page
@model Kiseki.Web.Pages.Series.CreateModel
@{
    ViewData["Title"] = "Create series";
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Series/Index">Series</a><span>/</span><span>Create</span>
</nav>

<div class="page-header compact">
    <div>
        <p class="eyebrow">Organization</p>
        <h1>Create series</h1>
        <p class="page-description">Create a container for grouping installments of a specific media type.</p>
    </div>
</div>

<section class="content-card form-card">
    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="form-error-summary mb-3" role="alert"></div>

        <div class="form-stack">
            <div>
                <label class="form-label" asp-for="Input.Title">Title</label>
                <input class="form-control" asp-for="Input.Title" placeholder="e.g. Re:Zero Light Novels" autofocus />
                <span asp-validation-for="Input.Title" class="form-field-error"></span>
            </div>
            <div>
                <label class="form-label" asp-for="Input.MediaType">Media type</label>
                <select class="form-select" asp-for="Input.MediaType" asp-items="Html.GetEnumSelectList<Kiseki.Core.Entities.MediaType>()"></select>
                <span asp-validation-for="Input.MediaType" class="form-field-error"></span>
            </div>
        </div>
        <div class="form-actions mt-4">
            <button class="btn btn-primary" type="submit">Create series</button>
            <a class="btn btn-link" asp-page="/Series/Index">Cancel</a>
        </div>
    </form>
</section>
