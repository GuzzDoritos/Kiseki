@page
@model Web.Pages.Import.JitenModel
@{
    ViewData["Title"] = "Search Jiten";
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Import/Index">Import</a><span>/</span><span>Jiten</span>
</nav>

<div class="page-header compact">
    <div>
        <p class="eyebrow">Jiten catalogue</p>
        <h1>Search Jiten</h1>
        <p class="page-description">Choose a complete deck or drill down to an individual subdeck.</p>
    </div>
</div>

<section class="content-card form-card">
    <div class="scaffold-notice">Search will be enabled when the web application registers IJitenApiClient.</div>
    <form method="get" class="search-form">
        <label class="visually-hidden" for="jiten-query">Book title</label>
        <input id="jiten-query" class="form-control form-control-lg" type="search" placeholder="Search by Japanese, romaji, or English title…" disabled />
        <button class="btn btn-primary" type="submit" disabled>Search</button>
    </form>
</section>

<section class="content-card empty-state compact-empty">
    <div class="empty-icon">J</div>
    <h2>Search results will appear here</h2>
    <p>Decks with subdecks will expose both “link entire deck” and individual subdeck choices.</p>
</section>
