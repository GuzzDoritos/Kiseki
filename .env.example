# Kiseki Configuration
# Copy this file to .env for local testing (it will be ignored by git)

# Password required to access Kiseki (e.g. admin, kiseki, or your own secret)
KISEKI_PASSWORD=kiseki

# Path to the SQLite database file
# Defaults to %LOCALAPPDATA%\kiseki.db on Windows if omitted
KISEKI_DB_PATH=%LOCALAPPDATA%\kiseki.db
