@model MediaWorkListItemViewModel
@{
    var progressLabel = Model.CurrentCharacterPosition is int position && Model.TotalCharacters > 0
        ? $"{position:N0} / {Model.TotalCharacters:N0} ch position"
        : Model.TotalCharacters > 0
            ? $"{Model.CharactersRead:N0} / {Model.TotalCharacters:N0} ch"
            : $"{Model.CharactersRead:N0} ch";
    var progress = new ProgressBarViewModel(
        Model.ProgressCurrent,
        Model.TotalCharacters,
        progressLabel,
        Model.IsCompleted,
        false,
        Model.PositionProgressPercentage);
}

<article class="media-row">
    <div class="media-row-link">
        <a class="media-details-overlay"
           asp-page="/Library/Details"
           asp-route-id="@Model.Id"
           aria-label="Open @Model.Title details"></a>
        <span class="media-cover media-cover-@Model.MediaType.ToString().ToLowerInvariant() @(Model.CoverUrl is not null ? "has-image" : string.Empty)"
              aria-hidden="true"
              data-cover-frame>
            @if (Model.CoverUrl is not null)
            {
                <img class="media-cover-image"
                     src="@Model.CoverUrl"
                     alt=""
                     loading="lazy"
                     referrerpolicy="no-referrer"
                     data-cover-image />
            }
            <span data-cover-fallback hidden="@(Model.CoverUrl is not null ? "hidden" : null)">@Model.TypeToJapanese</span>
        </span>

        <div class="media-copy">
            <span class="media-title">@Model.Title</span>
            <span class="media-series">@(Model.SeriesTitle ?? "Standalone")</span>
            <span class="media-tags">
                <span class="media-type-tag">@Model.MediaType</span>
                @if (Model.IsJitenLinked)
                {
                    <span class="source-tag"><i></i>Jiten</span>
                }
                @if (Model.SessionCount > 0)
                {
                    <span class="source-tag"><i></i>ッツ &times;@Model.SessionCount</span>
                }
                @if (Model.CoverSource == Kiseki.Core.Entities.MediaCoverSource.GoogleBooks && !string.IsNullOrWhiteSpace(Model.CoverProviderItemId))
                {
                    <span class="source-tag">
                        <a href="https://books.google.com/books?id=@Model.CoverProviderItemId"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="google-books-item-link text-inherit text-decoration-none">
                            Google Books
                        </a>
                    </span>
                }
            </span>
        </div>

        <div class="media-row-progress">
            <partial name="_ProgressBar" model="progress" />
        </div>

        <span class="media-status media-status-@Model.StatusCssClass">
            <i aria-hidden="true"></i>
            @Model.StatusLabel
        </span>
    </div>
</article>
