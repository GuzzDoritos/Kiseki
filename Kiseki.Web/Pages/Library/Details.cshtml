@page "{id:guid}"
@model Kiseki.Web.Pages.Library.DetailsModel
@{
    ViewData["Title"] = Model.Work.Title;
    var progressCurrent = Model.Work.CurrentCharacterPosition ?? Model.Work.CharactersRead;
    var progressLabel = Model.Work.CurrentCharacterPosition is int position && Model.Work.TotalCharacters > 0
        ? $"{position:N0} / {Model.Work.TotalCharacters:N0}"
        : Model.Work.TotalCharacters > 0
            ? $"{Model.Work.CharactersRead:N0} / {Model.Work.TotalCharacters:N0} characters"
            : $"{Model.Work.CharactersRead:N0} characters read";
    var progress = new ProgressBarViewModel(
        progressCurrent,
        Model.Work.TotalCharacters,
        progressLabel,
        Model.Work.IsCompleted,
        Model.Work.TotalCharacters > 0 || Model.Work.IsCompleted,
        Model.Work.PositionProgressPercentage);
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Library/Index">← Library</a>
</nav>

<form id="antiforgeryForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

@if (TempData["LibraryNotice"] is string libraryNotice)
{
    <div class="page-notice" role="status">@libraryNotice</div>
}

<div class="page-header">
    <div>
        <div class="inline-edit-wrapper title-edit-wrapper"
             data-inline-edit="title"
             data-url="@Url.Page("/Library/Details", "UpdateTitle", new { id = Model.Work.Id })">
            <h1 class="inline-edit-heading">
                <span class="inline-edit-display" data-inline-display>
                    <span class="inline-edit-text" data-inline-text>@Model.Work.Title</span>
                    <button type="button" class="inline-edit-trigger" data-inline-trigger aria-label="Edit title" title="Edit title">
                        <svg class="inline-edit-pencil" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M11.5 2.5a1.414 1.414 0 0 1 2 2L4.75 13.25 2 14l.75-2.75L11.5 2.5z"></path>
                        </svg>
                    </button>
                </span>
                <span class="inline-edit-editor" data-inline-editor hidden>
                    <input type="text"
                           class="inline-edit-input title-inline-input"
                           data-inline-input
                           value="@Model.Work.Title"
                           data-initial-value="@Model.Work.Title"
                           maxlength="500"
                           aria-label="Edit title" />
                    <button type="button" class="inline-edit-save-btn" data-inline-save aria-label="Save title" title="Save">
                        <svg class="inline-edit-check-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
                        </svg>
                    </button>
                </span>
            </h1>
            <div class="inline-edit-error" data-inline-error role="alert" aria-live="polite" hidden></div>
        </div>

    </div>
    <div class="page-actions">
        @if (Model.Work.MediaType == MediaType.Book)
        {
            <a class="btn btn-primary"
               asp-page="/Library/LinkJiten"
               asp-route-id="@Model.Work.Id">
                @(Model.Work.HasJitenLink ? "Change Jiten link" : "Link to Jiten")
            </a>
        }
    </div>
</div>

<div class="detail-grid">
    <section class="content-card detail-primary">
        <div class="detail-overview">
            <div class="detail-cover @(Model.Work.JitenCoverUrl is not null ? "has-image" : string.Empty)" data-cover-frame>
                @if (Model.Work.JitenCoverUrl is not null)
                {
                    <img src="@Model.Work.JitenCoverUrl"
                         alt="Cover for @Model.Work.Title"
                         loading="lazy"
                         referrerpolicy="no-referrer"
                         data-cover-image />
                }
                <span data-cover-fallback hidden="@(Model.Work.JitenCoverUrl is not null ? "hidden" : null)">@Model.Work.MediaType</span>
                <button type="button"
                        class="cover-edit-trigger cover-edit-overlay"
                        data-cover-edit-trigger
                        aria-label="Edit cover image"
                        title="Edit cover image">
                    <svg class="cover-edit-pencil" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M11.5 2.5a1.414 1.414 0 0 1 2 2L4.75 13.25 2 14l.75-2.75L11.5 2.5z"></path>
                    </svg>
                    Edit
                </button>
            </div>

            <div class="detail-progress">
                <div class="detail-heading">
                    <h2>Progress</h2>
                    <div class="page-status-wrap">
                        <button type="button"
                                class="media-status media-status-@Model.Work.StatusCssClass status-toggle-badge"
                                data-status-toggle
                                data-url="@Url.Page("/Library/Details", "ToggleStatus", new { id = Model.Work.Id })"
                                title="Click to toggle status between Reading and Completed"
                                aria-label="Status: @Model.Work.StatusLabel. Click to toggle.">
                            <span data-status-text>@Model.Work.StatusLabel</span>
                        </button>
                    </div>
                </div>
                <partial name="_ProgressBar" model="progress" />

                <dl class="detail-stat-grid">
                    <div><dt>Characters tracked</dt><dd data-characters-read="@Model.Work.CharactersRead">@Model.Work.CharactersRead.ToString("N0")</dd></div>
                    <div>
                        <dt>Character total</dt>
                        <dd class="inline-edit-wrapper stat-inline-wrapper"
                            data-inline-edit="characterTotal"
                            data-url="@Url.Page("/Library/Details", "UpdateCharacterTotal", new { id = Model.Work.Id })">
                            <span class="inline-edit-display" data-inline-display>
                                <span class="inline-edit-text" data-inline-text>@(Model.Work.TotalCharacters > 0 ? Model.Work.TotalCharacters.ToString("N0") : "Not set")</span>
                                <button type="button" class="inline-edit-trigger" data-inline-trigger aria-label="Edit character total" title="Edit character total">
                                    <svg class="inline-edit-pencil" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M11.5 2.5a1.414 1.414 0 0 1 2 2L4.75 13.25 2 14l.75-2.75L11.5 2.5z"></path>
                                    </svg>
                                </button>
                            </span>
                            <span class="inline-edit-editor" data-inline-editor hidden>
                                <input type="text"
                                       inputmode="numeric"
                                       class="inline-edit-input stat-inline-input"
                                       data-inline-input
                                       value="@(Model.Work.TotalCharacters > 0 ? Model.Work.TotalCharacters.ToString() : string.Empty)"
                                       data-initial-value="@(Model.Work.TotalCharacters > 0 ? Model.Work.TotalCharacters.ToString() : string.Empty)"
                                       placeholder="e.g. 150000"
                                       aria-label="Edit character total" />
                                <button type="button" class="inline-edit-save-btn" data-inline-save aria-label="Save character total" title="Save">
                                    <svg class="inline-edit-check-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="3.5 8.5 6.5 11.5 12.5 4.5"></polyline>
                                    </svg>
                                </button>
                            </span>
                            <span class="inline-edit-error" data-inline-error role="alert" aria-live="polite" hidden></span>
                        </dd>
                    </div>
                    <div><dt>Sessions</dt><dd>@Model.Work.SessionCount.ToString("N0")</dd></div>
                    <div><dt>Reading time</dt><dd>@Model.Work.TotalTimeLabel</dd></div>
                </dl>
            </div>
        </div>
    </section>

    <aside class="content-card detail-aside">
        <dl class="metadata-list">
            <div><dt>Series</dt><dd>@(Model.Work.SeriesTitle ?? "Unassigned")</dd></div>
            <div><dt>Jiten</dt><dd>@Model.Work.JitenLinkLabel</dd></div>
            @if (Model.Work.JitenCharacterCount is int jitenCharacters)
            {
                <div><dt>Jiten characters</dt><dd>@jitenCharacters.ToString("N0")</dd></div>
            }
            @if (Model.Work.TtsuCharacterCount is int ttsuCharacters)
            {
                <div><dt>ッツ characters</dt><dd>@ttsuCharacters.ToString("N0")</dd></div>
            }
            @if (Model.Work.ManualCharacterCountOverride is int manualCharacters)
            {
                <div data-metadata-manual-row><dt>Manual total</dt><dd data-metadata-manual-total>@manualCharacters.ToString("N0")</dd></div>
            }
            <div><dt>Total source</dt><dd data-metadata-source>@Model.Work.CharacterTotalSource</dd></div>
        </dl>
    </aside>
</div>

<div class="cover-edit-backdrop"
     data-cover-edit-backdrop
     data-url="@Url.Page("/Library/Details", "UpdateCoverUrl", new { id = Model.Work.Id })"
     hidden>
    <section class="cover-edit-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="cover-edit-title">
        <div class="cover-edit-header">
            <h2 id="cover-edit-title" class="cover-edit-title">Edit cover image</h2>
            <button type="button"
                    class="cover-edit-close-btn"
                    data-cover-edit-close
                    aria-label="Close cover editor"
                    title="Close">&times;</button>
        </div>
        <div class="cover-edit-field-row">
            <input type="url"
                   class="cover-edit-input"
                   data-cover-edit-input
                   value="@Model.Work.JitenCoverUrl"
                   maxlength="2048"
                   aria-label="Cover image URL"
                   aria-describedby="cover-edit-error" />
            <button type="button" class="cover-edit-save-btn" data-cover-edit-save>Save</button>
        </div>
        <div id="cover-edit-error"
             class="cover-edit-error"
             data-cover-edit-error
             role="alert"
             aria-live="polite"
             hidden></div>
    </section>
</div>

<section class="content-card section-block">
    <div class="section-heading">
        <div>
            <h2>Sessions</h2>
        </div>
    </div>

    @if (Model.Work.Logs.Count == 0)
    {
        <div class="inline-empty">No immersion sessions have been recorded for this work.</div>
    }
    else
    {
        <div class="immersion-log-table-wrap">
            <table class="immersion-log-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Characters</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Work.Logs)
                    {
                        <tr>
                            <td><time datetime="@log.Date.ToString("yyyy-MM-dd")">@log.Date.ToString("MMM d, yyyy")</time></td>
                            <td>@log.CharactersRead.ToString("N0")</td>
                            <td>@log.TimeSpentLabel</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
