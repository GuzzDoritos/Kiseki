@page
@model Kiseki.Web.Pages.Series.RefreshJitenModel
@{
    var vm = Model.ViewModel;
    ViewData["Title"] = $"Refresh {vm?.Title ?? "Series"} - Jiten";
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Series/Index">Series</a><span>/</span>
    @if (vm is not null)
    {
        <a asp-page="/Series/Details" asp-route-id="@vm.SeriesId">@vm.Title</a><span>/</span>
    }
    <span>Refresh from Jiten</span>
</nav>

@if (vm is not null)
{
    <div class="page-header">
        <div>
            <span class="media-badge media-badge-@vm.MediaType.ToString().ToLowerInvariant()">@vm.MediaType series</span>
            <h1>Refresh @vm.Title from Jiten</h1>
            <p class="page-description">Review and reconcile catalogue volumes with authoritative Jiten metadata</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" asp-page="/Series/Details" asp-route-id="@vm.SeriesId">Back to series</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <div class="page-notice" role="status">@Model.Notice</div>
    }
    @if (!string.IsNullOrEmpty(vm.ErrorMessage))
    {
        <div class="page-error" role="alert">
            <p class="mb-1"><strong>Error:</strong> @vm.ErrorMessage</p>
            @if (vm.RetryAfterSeconds.HasValue)
            {
                <p class="mb-0 text-muted">Please wait @vm.RetryAfterSeconds.Value seconds before trying again.</p>
            }
        </div>
    }

    @switch (vm.State)
    {
        case Kiseki.Web.Models.RefreshJitenUiState.DeckPrompt:
            <div class="content-card section-block">
                @if (vm.JitenDeckId.HasValue)
                {
                    <div class="deck-prompt-section">
                        <h2>Refresh Anchored Deck</h2>
                        <p class="text-secondary">
                            This series is linked to Jiten Deck <strong>#@vm.JitenDeckId.Value</strong>.
                            Fetch the latest catalogue data from Jiten to inspect additions, changes, and missing entries before applying them.
                        </p>

                        <form method="post" asp-page-handler="Preview" asp-route-seriesId="@vm.SeriesId"
                              data-submit-lock aria-describedby="preview-submit-status">
                            <input type="hidden" name="deckId" value="@vm.JitenDeckId.Value" />
                            <div class="d-flex align-items-center gap-3">
                                <button type="submit" class="btn btn-primary" id="btn-fetch-preview"
                                        data-submitting-label="Fetching preview…">
                                    Fetch Jiten Preview
                                </button>
                                <a asp-page="/Series/Details" asp-route-id="@vm.SeriesId" class="btn btn-outline-secondary">
                                    Cancel
                                </a>
                            </div>
                            <span class="visually-hidden" id="preview-submit-status" data-submit-status aria-live="polite"></span>
                        </form>
                    </div>
                }
                else
                {
                    <div class="deck-prompt-section">
                        <h2>Link &amp; Refresh from Jiten Deck</h2>
                        <p class="text-secondary">
                            This series is not yet linked to a Jiten parent deck. Enter a Jiten Deck ID to preview its catalogue installments.
                            Upon confirmation, this series will be anchored to that deck.
                        </p>

                        <form method="post" asp-page-handler="Preview" asp-route-seriesId="@vm.SeriesId"
                              class="needs-validation" data-submit-lock aria-describedby="preview-submit-status">
                            <div class="mb-3 max-w-sm">
                                <label for="deckId" class="form-label">Jiten Deck ID</label>
                                <input type="number" class="form-control" id="deckId" name="deckId" min="1" required
                                       placeholder="e.g. 10" value="@Model.DeckId" aria-describedby="deckIdHelp" />
                                <div id="deckIdHelp" class="form-text">
                                    The ID of the parent series deck on Jiten.moe.
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <button type="submit" class="btn btn-primary" id="btn-fetch-preview"
                                        data-submitting-label="Fetching preview…">
                                    Fetch Jiten Preview
                                </button>
                                <a asp-page="/Series/Details" asp-route-id="@vm.SeriesId" class="btn btn-outline-secondary">
                                    Cancel
                                </a>
                            </div>
                            <span class="visually-hidden" id="preview-submit-status" data-submit-status aria-live="polite"></span>
                        </form>
                    </div>
                }
            </div>
            break;

        case Kiseki.Web.Models.RefreshJitenUiState.Reviewing:
            <div class="review-header-card content-card section-block mb-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <h2>Catalogue Review for Deck #@vm.JitenDeckId</h2>
                        <p class="text-secondary mb-1">
                            Retrieved @vm.RetrievedItems of @vm.ExpectedItems expected provider items.
                            Review proposed actions below before applying changes.
                        </p>
                        @if (vm.ExpiresAtUtc.HasValue)
                        {
                            <span class="expiry-indicator text-muted" aria-live="polite">
                                Review active until @vm.ExpiresAtUtc.Value.ToLocalTime().ToString("HH:mm:ss")
                            </span>
                        }
                    </div>

                    <div class="review-status-badges d-flex gap-2">
                        @if (vm.IsCompleteFetch)
                        {
                            <span class="badge bg-success">Complete Fetch</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Incomplete Fetch</span>
                        }
                    </div>
                </div>

                @if (!vm.IsCompleteFetch)
                {
                    <div class="page-notice page-notice-warning mt-3 mb-0" role="alert">
                        <strong>Warning: Incomplete pagination.</strong>
                        Absence cannot be established; missing items cannot be marked missing and may only be ignored.
                    </div>
                }

                @if (!string.IsNullOrEmpty(vm.Warning))
                {
                    <div class="page-notice page-notice-warning mt-3 mb-0" role="alert">
                        @vm.Warning
                    </div>
                }
            </div>

            @if (vm.Proposals is null || vm.Proposals.Count == 0)
            {
                <div class="content-card section-block text-center py-5">
                    <p class="text-secondary mb-3">No catalogue changes detected for this deck.</p>
                    <form method="post" asp-page-handler="Apply" asp-route-seriesId="@vm.SeriesId"
                          data-submit-lock aria-describedby="apply-submit-status">
                        <input type="hidden" name="applyReviewId" value="@vm.ReviewId" />
                        <input type="hidden" name="applyExpectedFingerprint" value="@vm.Fingerprint" />
                        <input type="hidden" name="applyOperationId" value="@vm.OperationId" />
                        <div class="d-flex align-items-center justify-content-center gap-3">
                            <button type="submit" class="btn btn-primary" id="btn-apply-refresh"
                                    data-submitting-label="Applying reviewed state…">
                                Confirm Reviewed State
                            </button>
                            <a asp-page="/Series/Details" asp-route-id="@vm.SeriesId" class="btn btn-outline-secondary">
                                Return to Series
                            </a>
                        </div>
                        <span class="visually-hidden" id="apply-submit-status" data-submit-status aria-live="polite"></span>
                    </form>
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="Apply" asp-route-seriesId="@vm.SeriesId"
                      data-submit-lock aria-describedby="apply-submit-status">
                    <input type="hidden" name="applyReviewId" value="@vm.ReviewId" />
                    <input type="hidden" name="applyExpectedFingerprint" value="@vm.Fingerprint" />
                    <input type="hidden" name="applyOperationId" value="@vm.OperationId" />

                    <div class="proposals-list mb-4">
                        @for (var i = 0; i < vm.Proposals.Count; i++)
                        {
                            var proposal = vm.Proposals[i];
                            <div class="proposal-card content-card mb-3" data-proposal-id="@proposal.ProposalId">
                                <input type="hidden" name="Choices[@i].ProposalId" value="@proposal.ProposalId" />

                                <div class="proposal-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @proposal.BadgeCssClass">@proposal.BadgeText</span>
                                        <h3 class="proposal-title mb-0">@proposal.Title</h3>
                                    </div>
                                    <code class="text-muted small">@proposal.ProviderKey</code>
                                </div>

                                <div class="proposal-card-body mt-3">
                                    <div class="row g-3">
                                        <div class="col-md-7 d-flex gap-3">
                                            <div class="cover-frame cover-frame-sm flex-shrink-0" data-cover-frame>
                                                @if (!string.IsNullOrEmpty(proposal.CoverUrl))
                                                {
                                                    <img src="@proposal.CoverUrl" alt="Cover for @proposal.Title"
                                                         loading="lazy" referrerpolicy="no-referrer" data-cover-image />
                                                }
                                                <div class="cover-fallback" data-cover-fallback @(!string.IsNullOrEmpty(proposal.CoverUrl) ? "hidden" : "")>
                                                    @vm.TypeToJapanese
                                                </div>
                                            </div>

                                            <div class="proposal-details flex-grow-1">
                                                <div class="proposal-metadata-grid text-secondary small mb-2">
                                                    <div>
                                                        <strong>Characters:</strong>
                                                        @(proposal.CharacterCount.HasValue ? $"{proposal.CharacterCount.Value:N0} ch" : "Unknown")
                                                    </div>
                                                    <div>
                                                        <strong>Status:</strong>
                                                        @proposal.ReleaseStateText
                                                    </div>
                                                    <div>
                                                        <strong>Provider Order:</strong>
                                                        #@proposal.ProviderOrder
                                                    </div>
                                                </div>

                                                @if (proposal.ExistingInstallmentTitle is not null)
                                                {
                                                    <div class="proposal-matched-local small mb-2">
                                                        <span class="text-muted">Matched local installment:</span>
                                                        <strong>@proposal.ExistingInstallmentTitle</strong>
                                                    </div>
                                                }

                                                @if (proposal.HasManualConflict)
                                                {
                                                    <div class="proposal-callout proposal-conflict-callout small mb-2" role="note">
                                                        <strong>Manual conflict:</strong> This installment has manual overrides (title, character count, or release state) which will be preserved.
                                                    </div>
                                                }

                                                @if (proposal.HasUncertainOrder)
                                                {
                                                    <div class="proposal-callout proposal-uncertain-callout small mb-2" role="note">
                                                        <strong>Uncertain order:</strong> Duplicate title or non-standard order detected in Jiten data.
                                                    </div>
                                                }

                                                <p class="proposal-message small text-muted mb-0">@proposal.Message</p>
                                            </div>
                                        </div>

                                        <div class="col-md-5">
                                            <fieldset class="proposal-actions-fieldset border rounded p-3 h-100">
                                                <legend class="col-form-label pt-0 pb-2 fs-6 fw-bold">Select Action</legend>

                                                @foreach (var action in proposal.AllowedActions)
                                                {
                                                    var radioId = $"choice_{i}_{action}";
                                                    var isChecked = proposal.SelectedAction == action;
                                                    <div class="form-check mb-2">
                                                        <input class="form-check-input" type="radio"
                                                               name="Choices[@i].Action"
                                                               id="@radioId"
                                                               value="@action"
                                                               @(isChecked ? "checked" : "") />
                                                        <label class="form-check-label d-flex align-items-center gap-1" for="@radioId">
                                                            <span>@FormatActionLabel(action)</span>
                                                            @if (action == proposal.RecommendedAction)
                                                            {
                                                                <span class="badge bg-secondary ms-1 small">Recommended</span>
                                                            }
                                                        </label>

                                                        @if (action == Kiseki.Core.Services.JitenCatalogueChoiceAction.LinkExisting)
                                                        {
                                                            <div class="candidate-selector mt-2 ps-1">
                                                                <label for="candidate_@i" class="form-label small text-muted mb-1">
                                                                    Target installment:
                                                                </label>
                                                                <select class="form-select form-select-sm"
                                                                        name="Choices[@i].InstallmentId"
                                                                        id="candidate_@i"
                                                                        aria-label="Target installment for @proposal.Title">
                                                                    @foreach (var candidate in proposal.Candidates)
                                                                    {
                                                                        var isSelected = proposal.SelectedInstallmentId == candidate.Id;
                                                                        <option value="@candidate.Id" selected="@(isSelected ? "selected" : null)">
                                                                            #@candidate.OrderKey: @candidate.Title
                                                                        </option>
                                                                    }
                                                                </select>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="review-submit-bar d-flex align-items-center gap-3 py-3 border-top">
                        <button type="submit" class="btn btn-primary" id="btn-apply-refresh"
                                data-submitting-label="Applying changes…">
                            Confirm &amp; Apply Changes
                        </button>
                        <a asp-page="/Series/Details" asp-route-id="@vm.SeriesId" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                    <span class="visually-hidden" id="apply-submit-status" data-submit-status aria-live="polite"></span>
                </form>
            }
            break;

        case Kiseki.Web.Models.RefreshJitenUiState.Receipt:
            if (vm.Receipt is not null)
            {
                <div class="receipt-section content-card section-block">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <h2>Refresh Completed</h2>
                        @if (vm.Receipt.IsReplayed)
                        {
                            <span class="badge bg-info text-dark">Replayed Result</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Success</span>
                        }
                    </div>

                    @if (vm.Receipt.IsReplayed)
                    {
                        <div class="page-notice page-notice-info mb-4" role="status">
                            This refresh operation (ID: <code>@vm.Receipt.OperationId</code>) was already committed previously. Displaying durable receipt results.
                        </div>
                    }
                    else
                    {
                        <p class="text-secondary mb-4">
                            The catalogue for <strong>@vm.Title</strong> was successfully updated from Jiten Deck #@vm.Receipt.JitenDeckId.
                        </p>
                    }

                    <div class="receipt-stats-grid mb-4">
                        <div class="receipt-stat-card">
                            <span class="stat-number text-success">@vm.Receipt.AddedInstallments</span>
                            <span class="stat-label">Added Volumes</span>
                        </div>
                        <div class="receipt-stat-card">
                            <span class="stat-number text-info">@vm.Receipt.LinkedIdentities</span>
                            <span class="stat-label">Linked Identities</span>
                        </div>
                        <div class="receipt-stat-card">
                            <span class="stat-number text-primary">@vm.Receipt.UpdatedInstallments</span>
                            <span class="stat-label">Updated Metadata</span>
                        </div>
                        <div class="receipt-stat-card">
                            <span class="stat-number text-warning">@vm.Receipt.MarkedMissing</span>
                            <span class="stat-label">Marked Missing</span>
                        </div>
                        <div class="receipt-stat-card">
                            <span class="stat-number text-muted">@vm.Receipt.Ignored</span>
                            <span class="stat-label">Ignored</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 pt-3 border-top">
                        <span class="text-muted small">
                            Completed at: @vm.Receipt.CompletedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                        </span>
                        <a asp-page="/Series/Details" asp-route-id="@vm.SeriesId" class="btn btn-primary" id="btn-return-series">
                            Return to Series Details
                        </a>
                    </div>
                </div>
            }
            break;

        case Kiseki.Web.Models.RefreshJitenUiState.Error:
            <div class="error-section content-card section-block">
                <h2>Unable to Complete Refresh</h2>
                <p class="text-secondary mb-4">
                    @(vm.ErrorMessage ?? "An unexpected error occurred during catalogue reconciliation.")
                </p>

                <div class="d-flex align-items-center gap-3">
                    @if (vm.IsStaleReview)
                    {
                        <form method="post" asp-page-handler="Preview" asp-route-seriesId="@vm.SeriesId"
                              data-submit-lock aria-describedby="refresh-submit-status">
                            <input type="hidden" name="deckId" value="@vm.JitenDeckId" />
                            <button type="submit" class="btn btn-primary" id="btn-fetch-new-preview"
                                    data-submitting-label="Fetching preview…">
                                Fetch New Preview
                            </button>
                            <span class="visually-hidden" id="refresh-submit-status" data-submit-status aria-live="polite"></span>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/Series/RefreshJiten" asp-route-seriesId="@vm.SeriesId" class="btn btn-primary">
                            Try Again
                        </a>
                    }
                    <a asp-page="/Series/Details" asp-route-id="@vm.SeriesId" class="btn btn-outline-secondary">
                        Return to Series
                    </a>
                </div>
            </div>
            break;
    }
}

@functions {
    private static string FormatActionLabel(Kiseki.Core.Services.JitenCatalogueChoiceAction action) => action switch
    {
        Kiseki.Core.Services.JitenCatalogueChoiceAction.Apply => "Apply provider changes",
        Kiseki.Core.Services.JitenCatalogueChoiceAction.AddNew => "Add as new catalogue installment",
        Kiseki.Core.Services.JitenCatalogueChoiceAction.LinkExisting => "Link to existing installment",
        Kiseki.Core.Services.JitenCatalogueChoiceAction.MarkMissing => "Mark missing from provider",
        Kiseki.Core.Services.JitenCatalogueChoiceAction.Ignore => "Ignore / No action",
        _ => action.ToString()
    };
}
