@page
@model Kiseki.Web.Pages.Series.CreateModel
@{
    ViewData["Title"] = "Create series";
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Series/Index">Series</a><span>/</span><span>Create</span>
</nav>

<div class="page-header compact">
    <div>
        <p class="eyebrow">Organization</p>
        <h1>Create series</h1>
        <p class="page-description">
            Group installments of a series together to track your overall progress.
        </p>
    </div>
</div>

<div asp-validation-summary="All" class="import-validation" role="alert"></div>

<!-- Option 1: From Jiten (Recommended) -->
<section class="content-card jiten-search-card">
    <div class="section-heading mb-3">
        <div>
            <p class="eyebrow">Option 1 (Recommended)</p>
            <h2>Import from Jiten</h2>
            <p class="text-secondary small mb-0">Search Jiten to automatically populate all volumes, character counts, and covers.</p>
        </div>
    </div>

    <form method="get" class="search-form jiten-search-form">
        <label class="visually-hidden" asp-for="Query">Series title</label>
        <input class="form-control form-control-lg"
               asp-for="Query"
               type="search"
               autocomplete="off"
               placeholder="Japanese, romaji, or English series title (e.g. Spice and Wolf, 86)" />
        <button class="btn btn-primary" type="submit">Search Jiten</button>
    </form>
</section>

@if (Model.Results.Count > 0)
{
    <section class="jiten-results" aria-labelledby="jiten-results-title">
        <div class="section-heading jiten-results-heading">
            <div>
                <p class="eyebrow">Search results</p>
                <h2 id="jiten-results-title">@Model.Results.Count matching @(Model.Results.Count == 1 ? "deck" : "decks")</h2>
            </div>
            <span>Existing library books with matching Jiten IDs will be automatically linked.</span>
        </div>

        <div class="jiten-result-list">
            @foreach (var result in Model.Results)
            {
                <article class="content-card jiten-result-card">
                    <div class="jiten-cover @(result.CoverUrl is not null ? "has-image" : string.Empty)" data-cover-frame>
                        @if (result.CoverUrl is not null)
                        {
                            <img src="@result.CoverUrl"
                                 alt="Cover for @result.DisplayTitle"
                                 loading="lazy"
                                 referrerpolicy="no-referrer"
                                 data-cover-image />
                        }
                        <span data-cover-fallback hidden="@(result.CoverUrl is not null ? "hidden" : null)">本</span>
                    </div>

                    <div class="jiten-result-copy">
                        <h3>@result.DisplayTitle</h3>
                        @if (!string.IsNullOrWhiteSpace(result.EnglishTitle) && result.EnglishTitle != result.DisplayTitle)
                        {
                            <p>@result.EnglishTitle</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(result.RomajiTitle) && result.RomajiTitle != result.DisplayTitle)
                        {
                            <p>@result.RomajiTitle</p>
                        }
                        <div class="jiten-result-meta">
                            <span>Deck @result.DeckId</span>
                            <span>@result.CharacterCount.ToString("N0") characters</span>
                            @if (result.ChildrenDeckCount > 0)
                            {
                                <span>@result.ChildrenDeckCount volumes / subdecks</span>
                            }
                        </div>
                    </div>

                    <div class="jiten-result-actions">
                        <form method="post" asp-page-handler="Jiten">
                            <input type="hidden" name="deckId" value="@result.DeckId" />
                            <input type="hidden" name="Query" value="@Model.Query" />
                            <button class="btn btn-primary" type="submit">
                                Import as series
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    </section>
}

<!-- Option 2: Create Manually -->
<section class="content-card form-card mt-4">
    <div class="section-heading mb-3">
        <div>
            <p class="eyebrow">Option 2</p>
            <h2>Create empty series manually</h2>
            <p class="text-secondary small mb-0">For novel series where each volume is a separate deck on Jiten (like <em>Aobuta</em>) or for custom series.</p>
        </div>
    </div>

    <form method="post" asp-page-handler="Manual">
        <div class="form-stack">
            <div>
                <label class="form-label" asp-for="ManualInput.Title"></label>
                <input class="form-control" asp-for="ManualInput.Title" placeholder="e.g. Rascal Does Not Dream Series" />
                <span asp-validation-for="ManualInput.Title" class="text-danger"></span>
            </div>
            <div>
                <label class="form-label" asp-for="ManualInput.MediaType"></label>
                <select class="form-select" asp-for="ManualInput.MediaType" asp-items="Html.GetEnumSelectList<MediaType>()"></select>
            </div>
        </div>
        <div class="form-actions mt-3">
            <button class="btn btn-secondary" type="submit">Create empty series</button>
            <a class="btn btn-link" asp-page="/Series/Index">Cancel</a>
        </div>
    </form>
</section>

