@page "{id:guid}"
@model Kiseki.Web.Pages.Series.EditModel
@{
    ViewData["Title"] = "Edit series";
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Series/Index">Series</a><span>/</span>
    <a asp-page="/Series/Details" asp-route-id="@Model.Id">Series details</a><span>/</span><span>Edit</span>
</nav>

<div class="page-header compact">
    <div>
        <p class="eyebrow">Organization</p>
        <h1>Edit series</h1>
        <p class="page-description">Update the series title. Media type is fixed after creation.</p>
    </div>
</div>

<section class="content-card form-card">
    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="form-error-summary mb-3" role="alert"></div>

        <div class="form-stack">
            <div>
                <label class="form-label" asp-for="Input.Title">Title</label>
                <input class="form-control" asp-for="Input.Title" autofocus />
                <span asp-validation-for="Input.Title" class="form-field-error"></span>
            </div>
            <div>
                <label class="form-label">Media type</label>
                <div>
                    <span class="media-badge media-badge-@Model.MediaType.ToString().ToLowerInvariant()">@Model.MediaType</span>
                    <small class="text-muted ms-2">Media type cannot be changed after series creation.</small>
                </div>
            </div>
        </div>
        <div class="form-actions mt-4">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-link" asp-page="/Series/Details" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </form>
</section>
