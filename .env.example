# Kiseki Configuration
# Copy this file to .env for local testing (it will be ignored by git)

# Password required to access Kiseki
KISEKI_PASSWORD=kiseki

# Database Provider: 'sqlite' for local development, 'postgres' for Render/Neon
DatabaseProvider=sqlite

# Local SQLite database path (used when DatabaseProvider=sqlite)
# Defaults to %LOCALAPPDATA%\kiseki.db on Windows if omitted
KISEKI_DB_PATH=%LOCALAPPDATA%\kiseki.db

# Neon PostgreSQL Connection String (used when DatabaseProvider=postgres)
# ConnectionStrings__DefaultConnection=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
