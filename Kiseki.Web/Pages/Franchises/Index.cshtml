@page
@model Kiseki.Web.Pages.Franchises.IndexModel
@{
    ViewData["Title"] = "Franchises";
}

<div class="page-header">
    <div>
        <p class="eyebrow">Organization</p>
        <h1>Franchises</h1>
        <p class="page-description">Group related series across media types while keeping media units and progress separate.</p>
    </div>
    <a class="btn btn-primary" asp-page="/Franchises/Create">Create franchise</a>
</div>

@if (!string.IsNullOrEmpty(Model.Notice))
{
    <div class="page-notice" role="status">@Model.Notice</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="page-error" role="alert">@Model.Error</div>
}

@if (Model.Franchises.Count == 0)
{
    <section class="content-card empty-state">
        <div class="empty-icon">❖</div>
        <h2>No franchises to show yet</h2>
        <p>Group related book, anime, and game series into unified franchises.</p>
        <a class="btn btn-primary" asp-page="/Franchises/Create">Create your first franchise</a>
    </section>
}
else
{
    <div class="franchise-list">
        @foreach (var franchise in Model.Franchises)
        {
            <article class="content-card franchise-card mb-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h2 class="h4 mb-1">
                            <a asp-page="/Franchises/Details" asp-route-id="@franchise.Id" class="text-decoration-none">
                                @franchise.Title
                            </a>
                        </h2>
                        <div class="franchise-meta text-muted small d-flex align-items-center flex-wrap gap-2">
                            <span>@franchise.SeriesCount @(franchise.SeriesCount == 1 ? "series" : "series")</span>
                            @if (franchise.BookSeriesCount > 0)
                            {
                                <span>&bull; @franchise.BookSeriesCount @(franchise.BookSeriesCount == 1 ? "book" : "books")</span>
                            }
                            @if (franchise.AnimeSeriesCount > 0)
                            {
                                <span>&bull; @franchise.AnimeSeriesCount anime</span>
                            }
                            @if (franchise.OtherSeriesCount > 0)
                            {
                                <span>&bull; @franchise.OtherSeriesCount other</span>
                            }
                            @if (franchise.JitenAnchorDeckId.HasValue)
                            {
                                <span class="badge bg-secondary">Jiten Anchor #@franchise.JitenAnchorDeckId</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Franchises/Details" asp-route-id="@franchise.Id">View details</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Franchises/Edit" asp-route-id="@franchise.Id">Edit</a>
                    </div>
                </div>
            </article>
        }
    </div>
}

