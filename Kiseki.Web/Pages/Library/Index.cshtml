@page
@model Kiseki.Web.Pages.Library.IndexModel
@{
    ViewData["Title"] = "Library";
    ViewData["MainClass"] = "app-main--flush";

    string TypeTabClass(MediaType? type) => Model.Type == type ? "active" : string.Empty;
}

<div class="library-page">
    @if (TempData["LibraryNotice"] is string libraryNotice)
    {
        <div class="library-notice" role="status">@libraryNotice</div>
    }

    <header class="library-header">
        <div class="library-heading">
            <h1>Library</h1>
            <span>@Model.TotalCount @(Model.TotalCount == 1 ? "work" : "works")</span>
        </div>

        <div class="library-header-actions">
            <form class="library-search" method="get" role="search">
                @if (Model.Type is not null)
                {
                    <input type="hidden" name="Type" value="@Model.Type" />
                }
                @if (Model.Status is not null)
                {
                    <input type="hidden" name="Status" value="@Model.Status" />
                }
                @if (Model.View is not null)
                {
                    <input type="hidden" name="View" value="@Model.View" />
                }
                <label class="visually-hidden" for="library-search">Search library</label>
                <svg aria-hidden="true" viewBox="0 0 16 16">
                    <circle cx="7" cy="7" r="4.5"></circle>
                    <path d="m10.5 10.5 3 3"></path>
                </svg>
                <input id="library-search" name="Search" type="search" value="@Model.Search" placeholder="Search library" />
            </form>
            <a class="primary-action" asp-page="/Import/Index">
                <span aria-hidden="true">+</span>
                Add media
            </a>
        </div>
    </header>

    <div class="library-filters">
        <nav class="filter-tabs" aria-label="Filter by media type">
            <a class="filter-tab @TypeTabClass(null)"
               asp-page="/Library/Index"
               asp-route-search="@Model.Search"
               asp-route-status="@Model.Status"
               asp-route-view="@Model.View">All</a>
            @foreach (var type in Enum.GetValues<MediaType>())
            {
                <a class="filter-tab @TypeTabClass(type)"
                   asp-page="/Library/Index"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status"
                   asp-route-type="@type"
                   asp-route-view="@Model.View">@(type == MediaType.Book ? "Books" 
                                             : type == MediaType.Game ? "Games" 
                                             : type.ToString())
                </a>
            }
        </nav>

        <form class="view-filter" method="get">
            @if (Model.Type is not null)
            {
                <input type="hidden" name="Type" value="@Model.Type" />
            }
            @if (Model.Search is not null)
            {
                <input type="hidden" name="Search" value="@Model.Search" />
            }
            @if (Model.Status is not null)
            {
                <input type="hidden" name="Status" value="@Model.Status" />
            }
            <div class="btn-group btn-group-sm heatmap-mode-group" role="group" aria-label="Select view mode">
                <input type="radio" class="btn-check" name="View" id="viewList" value="list" checked="@(Model.View != "grid")" onchange="this.form.submit()" autocomplete="off">
                <label class="btn btn-outline-secondary" for="viewList">List</label>

                <input type="radio" class="btn-check" name="View" id="viewGrid" value="grid" checked="@(Model.View == "grid")" onchange="this.form.submit()" autocomplete="off">
                <label class="btn btn-outline-secondary" for="viewGrid">Grid</label>
            </div>
        </form>

        <form class="status-filter" method="get">
            @if (Model.Type is not null)
            {
                <input type="hidden" name="Type" value="@Model.Type" />
            }
            @if (Model.Search is not null)
            {
                <input type="hidden" name="Search" value="@Model.Search" />
            }
            @if (Model.View is not null)
            {
                <input type="hidden" name="View" value="@Model.View" />
            }
            <label class="visually-hidden" for="library-status">Filter by status</label>
            <select id="library-status" name="Status" onchange="this.form.submit()">
                <option value="" selected="@(Model.Status is null)">All statuses</option>
                <option value="in-progress" selected="@(Model.Status == "in-progress")">In progress</option>
                <option value="not-started" selected="@(Model.Status == "not-started")">Not started</option>
                <option value="completed" selected="@(Model.Status == "completed")">Completed</option>
            </select>
        </form>
    </div>

    <section class="library-results" aria-label="Library results">
        @if (Model.Works.Count > 0)
        {
            @if (Model.View == "list") {
                <div class="media-list">
                    @foreach (var work in Model.Works)
                    {
                        <partial name="_MediaWorkRow" model="work" />
                    }
                </div>
            }
            else if (Model.View == "grid")
            {
                <div class="media-grid">
                    @foreach (var work in Model.Works)
                    {
                        <partial name="_MediaWorkCard" model="work" />
                    }
                </div>
            }
            
        }
        else
        {
            <div class="library-empty">
                @if (Model.TotalCount == 0)
                {
                    <h2>Your library is empty</h2>
                    <p>Add a work to start tracking your immersion progress.</p>
                    <a class="secondary-action" asp-page="/Import/Index">Add your first work</a>
                }
                else
                {
                    <h2>No matching works</h2>
                    <p>Nothing in your library matches these filters.</p>
                    <a class="secondary-action" asp-page="/Library/Index" asp-route-view="@Model.View">Clear filters</a>
                }
            </div>
        }
    </section>
</div>
