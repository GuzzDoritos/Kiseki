@page "{id:guid}"
@model Kiseki.Web.Pages.Series.DetailsModel
@{
    ViewData["Title"] = $"{Model.SeriesDetails.Title} - Series";
    var series = Model.SeriesDetails;
    var progress = series.Progress;
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Series/Index">Series</a><span>/</span><span>@series.Title</span>
</nav>

<div class="page-header">
    <div>
        <span class="media-badge media-badge-@series.MediaType.ToString().ToLowerInvariant()">@series.MediaType series</span>
        <h1>@series.Title</h1>
        <p class="page-description">@series.Installments.Count @(series.Installments.Count == 1 ? (series.MediaType == Kiseki.Core.Entities.MediaType.Book ? "volume" : "installment") : (series.MediaType == Kiseki.Core.Entities.MediaType.Book ? "volumes" : "installments")) in catalogue</p>
    </div>
    <div class="header-actions">
        @if (series.MediaType == Kiseki.Core.Entities.MediaType.Book)
        {
            <a class="btn btn-primary" asp-page="/Series/RefreshJiten" asp-route-seriesId="@series.Id" id="btn-refresh-jiten">Refresh from Jiten</a>
        }
        <a class="btn btn-outline-secondary" asp-page="/Series/Edit" asp-route-id="@series.Id">Edit series</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Notice))
{
    <div class="page-notice" role="status">@Model.Notice</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="page-error" role="alert">@Model.Error</div>
}
@if (series.IsTruncated)
{
    <div class="page-notice page-notice-warning" role="status">
        Showing the first 500 installments. Additional installments are truncated.
    </div>
}
@if (series.UnknownReleaseCount > 0)
{
    <div class="page-notice page-notice-warning d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3" role="status" id="unknown-release-alert">
        <div>
            <strong>@(series.UnknownReleaseCount == 1 ? "1 volume has an unknown release date" : $"{series.UnknownReleaseCount} volumes have unknown release dates")</strong>
            <div>Provider entries without confirmed release dates are excluded from whole-series progress. Use "Set release state" on any volume below to include it.</div>
        </div>
        <a href="#first-unknown-volume" class="btn btn-sm btn-outline-warning text-dark">Go to first unknown volume</a>
    </div>
}

<section class="content-card section-block mb-4">
    <div class="series-summary-grid">
        <div class="summary-card">
            <span class="summary-label">Volume Completion</span>
            <div class="summary-main-value">
                @if (series.ReleasedVolumeCount > 0)
                {
                    <span class="value-highlight">@series.CompletedVolumeCount / @series.ReleasedVolumeCount</span>
                    <span class="value-unit">released volumes completed</span>
                }
                else
                {
                    <span class="value-highlight">0</span>
                    <span class="value-unit">released volumes</span>
                }
            </div>
            <div class="summary-subtext d-flex align-items-center flex-wrap gap-2">
                <span class="badge @series.StatusBadgeCss">
                    @series.StatusLabel
                </span>
                @if (series.ReleasedVolumeCount > 0)
                {
                    <span class="text-muted">@series.TrackingSummary</span>
                }
                else
                {
                    <span class="text-muted">No released volumes in catalogue yet</span>
                }
            </div>
        </div>

        <div class="summary-card">
            <div class="d-flex justify-content-between align-items-baseline mb-2">
                <span class="summary-label mb-0">Reading Progress</span>
                @if (series.HasPartialCoverage)
                {
                    <span class="badge bg-dark-subtle text-muted">@series.PartialCoverageLabel</span>
                }
            </div>
            <div class="series-headline-progress-bar">
                <partial name="_ProgressBar" model="series.ProgressBar" />
            </div>
            <div class="summary-subtext text-muted mt-2">
                @if (series.ProgressPercentage.HasValue)
                {
                    <span>Character-based progress@(series.HasPartialCoverage ? $" (covers {series.ComputableVolumeCount} of {series.ReleasedVolumeCount} released volumes)" : string.Empty)</span>
                }
                else
                {
                    <span>No character count data available for released volumes</span>
                }
            </div>
        </div>
    </div>

    @if (series.HasNonHeadlineVolumes)
    {
        <div class="series-non-headline-bar d-flex flex-wrap align-items-center gap-2 mt-3 pt-2 border-top small text-muted">
            <span>Other catalogue entries:</span>
            @if (progress.UnknownReleaseInstallmentCount > 0)
            {
                <span class="badge bg-secondary">
                    @progress.UnknownReleaseInstallmentCount unknown release
                </span>
                <a href="#first-unknown-volume" class="small text-warning text-decoration-underline me-2">Set release state</a>
            }
            @if (progress.UpcomingInstallmentCount > 0)
            {
                <span class="badge bg-info text-dark">
                    @progress.UpcomingInstallmentCount upcoming
                </span>
            }
            @if (progress.ExcludedInstallmentCount > 0)
            {
                <span class="badge bg-warning text-dark">
                    @progress.ExcludedInstallmentCount excluded
                </span>
            }
        </div>
    }

    <details class="technical-coverage-details mt-3 pt-2 border-top">
        <summary class="small text-muted cursor-pointer">Detailed technical coverage & immersion metrics</summary>
        <div class="series-coverage-stats mt-2">
            <div class="coverage-stat-item">
                <span class="stat-label">Eligible & Released</span>
                <strong>@progress.EligibleInstallmentCount</strong>
                <small>@progress.UntrackedEligibleInstallmentCount untracked</small>
            </div>
            <div class="coverage-stat-item">
                <span class="stat-label">Known Canonical Totals</span>
                <strong>@progress.KnownCanonicalTotalInstallmentCount</strong>
                <small>@($"{progress.KnownCanonicalCharacterCount:N0} ch")</small>
            </div>
            <div class="coverage-stat-item">
                <span class="stat-label">Unknown Canonical Totals</span>
                <strong>@progress.UnknownCanonicalTotalInstallmentCount</strong>
                <small>needs metadata</small>
            </div>
            <div class="coverage-stat-item">
                <span class="stat-label">Computable Progress</span>
                <strong>@progress.ComputableProgressInstallmentCount</strong>
                <small>@($"{progress.ComputableProgressCharacterCount:N0} ch")</small>
            </div>
            <div class="coverage-stat-item">
                <span class="stat-label">Unknown Progress</span>
                <strong>@progress.UnknownProgressInstallmentCount</strong>
                <small>@($"{progress.UnknownProgressCharacterCount:N0} ch")</small>
            </div>
            <div class="coverage-stat-item">
                <span class="stat-label">Non-Headline Entries</span>
                <strong>@(progress.UpcomingInstallmentCount + progress.UnknownReleaseInstallmentCount + progress.ExcludedInstallmentCount)</strong>
                <small>@progress.UpcomingInstallmentCount upcoming &bull; @progress.UnknownReleaseInstallmentCount unknown &bull; @progress.ExcludedInstallmentCount excluded</small>
            </div>
            <div class="coverage-stat-item">
                <span class="stat-label">Lifetime Immersion</span>
                <strong>@($"{progress.LifetimeCharactersRead:N0} ch")</strong>
                <small>@($"{progress.LifetimeMinutes:N0} minutes")</small>
            </div>
        </div>
    </details>
</section>

<section class="content-card section-block">
    <div class="section-heading d-flex justify-content-between align-items-center mb-3">
        <div>
            <p class="eyebrow">Catalogue</p>
            <h2>@(series.MediaType == Kiseki.Core.Entities.MediaType.Book ? "Volumes" : "Installments")</h2>
        </div>
        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addInstallmentCollapse" aria-expanded="false" aria-controls="addInstallmentCollapse">
            + Add @(series.MediaType == Kiseki.Core.Entities.MediaType.Book ? "volume" : "installment")
        </button>
    </div>

    <div class="collapse mb-4" id="addInstallmentCollapse">
        <div class="p-3 border rounded bg-dark-subtle">
            <h3 class="h6 mb-3">Add new @(series.MediaType == Kiseki.Core.Entities.MediaType.Book ? "volume" : "installment")</h3>
            <form method="post" asp-page-handler="AddInstallment" asp-route-id="@series.Id">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="addTitle">Title</label>
                        <input class="form-control" id="addTitle" name="Title" placeholder="e.g. Volume 1" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="addKind">Kind</label>
                        <select class="form-select" id="addKind" name="Kind">
                            @foreach (var kind in Enum.GetValues<Kiseki.Core.Entities.InstallmentKind>())
                            {
                                <option value="@kind" selected="@(kind == Kiseki.Core.Entities.InstallmentKind.Volume ? "selected" : null)">@kind</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="addReleaseState">Release state</label>
                        <select class="form-select" id="addReleaseState" name="ReleaseState">
                            @foreach (var state in Enum.GetValues<Kiseki.Core.Entities.ReleaseState>())
                            {
                                <option value="@state" selected="@(state == Kiseki.Core.Entities.ReleaseState.Released ? "selected" : null)">@state</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="addReleaseDate">Release date</label>
                        <input class="form-control" type="date" id="addReleaseDate" name="ReleaseDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="addCanonicalCount">Canonical character count</label>
                        <input class="form-control" type="number" id="addCanonicalCount" name="CanonicalCharacterCount" min="1" placeholder="Optional" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="addOrderKey">Order key</label>
                        <input class="form-control" type="number" id="addOrderKey" name="OrderKey" placeholder="Auto (last + 100)" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="addIsIncluded" name="IsIncluded" value="true" checked />
                            <input type="hidden" name="IsIncluded" value="false" />
                            <label class="form-check-label" for="addIsIncluded">Include in progress</label>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary btn-sm" type="submit">Save @(series.MediaType == Kiseki.Core.Entities.MediaType.Book ? "volume" : "installment")</button>
                </div>
            </form>
        </div>
    </div>

    @if (series.Installments.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">▦</div>
            <h3>No @(series.MediaType == Kiseki.Core.Entities.MediaType.Book ? "volumes" : "installments") yet</h3>
            <p>Add volumes or entries above to start tracking this series.</p>
        </div>
    }
    else
    {
        var hasMarkedFirstUnknown = false;
        <div class="installments-list">
            @for (var i = 0; i < series.Installments.Count; i++)
            {
                var inst = series.Installments[i];
                var isFirst = i == 0;
                var isLast = i == series.Installments.Count - 1;
                var isFirstUnknown = inst.IsReleaseUnknown && !hasMarkedFirstUnknown;
                if (isFirstUnknown)
                {
                    hasMarkedFirstUnknown = true;
                }

                <article class="installment-card content-card mb-3 p-3" id="installment-@inst.Id">
                    @if (isFirstUnknown)
                    {
                        <span id="first-unknown-volume" class="visually-hidden">First unknown release volume</span>
                    }
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="media-cover media-cover-@series.MediaType.ToString().ToLowerInvariant() media-cover-sm @(inst.Cover is not null ? "has-image" : string.Empty)" aria-hidden="true" data-cover-frame>
                                @if (inst.Cover is not null)
                                {
                                    <img class="media-cover-image"
                                         src="@inst.Cover.Url"
                                         alt=""
                                         loading="lazy"
                                         referrerpolicy="no-referrer"
                                         data-cover-image />
                                }
                                <span data-cover-fallback hidden="@(inst.Cover is not null ? "hidden" : null)">@series.TypeToJapanese</span>
                            </span>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h4 class="h5 mb-0">@inst.Title</h4>
                                    @if (inst.Kind != Kiseki.Core.Entities.InstallmentKind.Volume)
                                    {
                                        <span class="media-badge">@inst.Kind</span>
                                    }
                                </div>
                                <div class="installment-meta text-muted small mt-1">
                                    @if (inst.CanonicalCharacterCount.HasValue)
                                    {
                                        <span>@($"{inst.CanonicalCharacterCount.Value:N0} ch")</span>
                                    }
                                    else
                                    {
                                        <span>Unknown character count</span>
                                    }
                                    @if (inst.EffectiveReleaseDate.HasValue)
                                    {
                                        <span>&bull; Released @inst.EffectiveReleaseDate.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                    @if (inst.IsReleaseUnknown)
                                    {
                                        <span class="text-warning-emphasis">&bull; Release date unknown &mdash; <button class="btn btn-link btn-sm p-0 align-baseline text-warning-emphasis text-decoration-underline" type="button" data-bs-toggle="collapse" data-bs-target="#editInstallment-@inst.Id">Set release state</button></span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge @(inst.EffectiveReleaseState == Kiseki.Core.Entities.ReleaseState.Released ? "bg-success-subtle text-success-emphasis" : inst.EffectiveReleaseState == Kiseki.Core.Entities.ReleaseState.Upcoming ? "bg-info text-dark" : "bg-warning text-dark")">
                                @(inst.EffectiveReleaseState == Kiseki.Core.Entities.ReleaseState.Unknown ? "Unknown release" : inst.EffectiveReleaseState.ToString())
                            </span>
                            @if (!inst.IsIncluded)
                            {
                                <span class="badge bg-warning text-dark">Excluded</span>
                            }
                            <span class="badge @(inst.IsCompleted ? "bg-success" : inst.IsTracked ? "bg-primary" : "bg-dark")">
                                @inst.StatusBadgeLabel
                            </span>
                        </div>
                    </div>

                    <div class="installment-progress-row mb-3">
                        @if (inst.ProgressBar != null)
                        {
                            <partial name="_ProgressBar" model="inst.ProgressBar" />
                        }
                        else if (inst.IsTracked)
                        {
                            <span class="text-muted small">Progress unknown (tracked copy has no usable total)</span>
                        }
                        else if (inst.EffectiveReleaseState == Kiseki.Core.Entities.ReleaseState.Released && inst.IsIncluded)
                        {
                            <span class="text-muted small">Catalogue only (0% progress)</span>
                        }
                        else
                        {
                            <span class="text-muted small">Not eligible for headline progress</span>
                        }
                    </div>

                    <div class="copies-section border-top pt-2 mt-2">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="small font-weight-bold text-muted">
                                    Tracked copies (@inst.Copies.Count)
                                </span>
                                <button class="btn btn-link btn-sm p-0 text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#createCopy-@inst.Id" aria-expanded="false" aria-controls="createCopy-@inst.Id">
                                    + Track copy
                                </button>
                                @if (series.AvailableCopies.Count > 0)
                                {
                                    <button class="btn btn-link btn-sm p-0 text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#associateCopy-@inst.Id" aria-expanded="false" aria-controls="associateCopy-@inst.Id">
                                        &bull; Associate copy
                                    </button>
                                }
                                <button class="btn btn-link btn-sm p-0 text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#editInstallment-@inst.Id" aria-expanded="false" aria-controls="editInstallment-@inst.Id">
                                    &bull; Edit
                                </button>
                                @if (inst.Copies.Count > 0 && series.Installments.Count > 1)
                                {
                                    <button class="btn btn-link btn-sm p-0 text-decoration-none text-warning" type="button" data-bs-toggle="collapse" data-bs-target="#consolidate-@inst.Id" aria-expanded="false" aria-controls="consolidate-@inst.Id">
                                        &bull; Consolidate
                                    </button>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small text-muted" title="Raw catalogue order key">#@inst.OrderKey</span>
                                <form method="post" asp-page-handler="ReorderInstallments" asp-route-id="@series.Id" class="d-inline-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="InstallmentId" value="@inst.Id" />
                                    @foreach (var snapshot in series.Installments)
                                    {
                                        <input type="hidden" name="ExpectedVersions[@snapshot.Id]" value="@snapshot.Version" />
                                    }
                                    <button type="submit" name="Direction" value="up" class="btn btn-outline-secondary btn-sm p-1" title="Move Up" @(isFirst ? "disabled" : "") aria-label="Move Up">&#x25B2;</button>
                                    <button type="submit" name="Direction" value="down" class="btn btn-outline-secondary btn-sm p-1" title="Move Down" @(isLast ? "disabled" : "") aria-label="Move Down">&#x25BC;</button>
                                </form>
                            </div>
                        </div>

                        @if (inst.Copies.Count > 0)
                        {
                            <div class="copies-list list-group list-group-flush mb-2">
                                @foreach (var copy in inst.Copies)
                                {
                                    <div class="list-group-item bg-transparent px-0 py-1 d-flex justify-content-between align-items-center">
                                        <div>
                                            <a asp-page="/Library/Details" asp-route-id="@copy.Id" class="fw-medium text-decoration-none">
                                                @copy.Title
                                            </a>
                                            <span class="badge @(copy.IsCompleted ? "bg-success" : "bg-primary") ms-2">
                                                @(copy.IsCompleted ? "Completed" : "Reading")
                                            </span>
                                        </div>
                                        <div class="small text-muted">
                                            @copy.ReadingProgressSummary
                                            @if (copy.ProgressPercentage.HasValue)
                                            {
                                                <span>(@($"{copy.ProgressPercentage.Value:N1}%"))</span>
                                            }
                                            @if (copy.MinutesRead > 0)
                                            {
                                                <span>&bull; @($"{copy.MinutesRead:N0} min")</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="small text-muted mb-2">Catalogue only &mdash; no tracked copies in your library.</p>
                        }

                        <div class="collapse mt-2 p-2 border rounded bg-body-tertiary" id="createCopy-@inst.Id">
                            <form method="post" asp-page-handler="CreateCopy" asp-route-id="@series.Id" class="d-flex gap-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="InstallmentId" value="@inst.Id" />
                                <label class="visually-hidden" for="copyTitle-@inst.Id">Copy edition title</label>
                                <input class="form-control form-control-sm" id="copyTitle-@inst.Id" name="Title" value="@inst.Title" placeholder="Copy edition title" required />
                                <button type="submit" class="btn btn-primary btn-sm text-nowrap">Create copy</button>
                            </form>
                        </div>

                        @if (series.AvailableCopies.Count > 0)
                        {
                            <div class="collapse mt-2 p-2 border rounded bg-body-tertiary" id="associateCopy-@inst.Id">
                                <form method="post" asp-page-handler="AssociateCopy" asp-route-id="@series.Id" class="d-flex gap-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="InstallmentId" value="@inst.Id" />
                                    <input type="hidden" name="TargetExpectedVersion" value="@inst.Version" />
                                    <label class="visually-hidden" for="copyReview-@inst.Id">Standalone library copy</label>
                                    <select class="form-select form-select-sm" id="copyReview-@inst.Id" name="CopyReview" required>
                                        <option value="">Select a library copy to associate...</option>
                                        @foreach (var available in series.AvailableCopies)
                                        {
                                            <option value="@available.ReviewValue">@available.Title [Standalone]</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-secondary btn-sm text-nowrap">Associate</button>
                                </form>
                            </div>
                        }

                        <div class="collapse mt-2 p-2 border rounded bg-body-tertiary" id="editInstallment-@inst.Id">
                            <form method="post" asp-page-handler="EditInstallment" asp-route-id="@series.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="InstallmentId" value="@inst.Id" />
                                <input type="hidden" name="ExpectedVersion" value="@inst.Version" />
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <label class="form-label small" for="editTitle-@inst.Id">Title</label>
                                        <input class="form-control form-control-sm" id="editTitle-@inst.Id" name="Title" value="@inst.Title" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small" for="editKind-@inst.Id">Kind</label>
                                        <select class="form-select form-select-sm" id="editKind-@inst.Id" name="Kind">
                                            @foreach (var kindVal in Enum.GetValues<Kiseki.Core.Entities.InstallmentKind>())
                                            {
                                                <option value="@kindVal" selected="@(inst.Kind == kindVal ? "selected" : null)">@kindVal</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small" for="editReleaseState-@inst.Id">Release state override</label>
                                        <select class="form-select form-select-sm" id="editReleaseState-@inst.Id" name="ReleaseStateOverride">
                                            <option value="">(Inherit / Original)</option>
                                            @foreach (var relVal in Enum.GetValues<Kiseki.Core.Entities.ReleaseState>())
                                            {
                                                <option value="@relVal" selected="@(inst.EffectiveReleaseState == relVal ? "selected" : null)">@relVal</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small" for="editReleaseDate-@inst.Id">Release date override</label>
                                        <input class="form-control form-control-sm" id="editReleaseDate-@inst.Id" type="date" name="ReleaseDateOverride" value="@(inst.EffectiveReleaseDate?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small" for="editCount-@inst.Id">Canonical count</label>
                                        <input class="form-control form-control-sm" id="editCount-@inst.Id" type="number" min="1" name="CanonicalCharacterCount" value="@inst.CanonicalCharacterCount" />
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end">
                                        <div class="form-check mb-1">
                                            <input class="form-check-input" type="checkbox" name="IsIncluded" value="true" checked="@(inst.IsIncluded ? "checked" : null)" id="editInc-@inst.Id" />
                                            <input type="hidden" name="IsIncluded" value="false" />
                                            <label class="form-check-label small" for="editInc-@inst.Id">Include in progress</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <button type="submit" class="btn btn-primary btn-sm">Save installment changes</button>
                                </div>
                            </form>
                        </div>

                        @if (inst.Copies.Count > 0 && series.Installments.Count > 1)
                        {
                            <div class="collapse mt-2 p-2 border border-warning rounded bg-body-tertiary" id="consolidate-@inst.Id">
                                <h4 class="h6 text-warning mb-1">Consolidate copies into another installment</h4>
                                <p class="small text-muted mb-2">
                                    Moves selected copies to the target installment. Preserves logs, bindings, and source installment.
                                </p>
                                <form method="post" asp-page-handler="Consolidate" asp-route-id="@series.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="SourceInstallmentId" value="@inst.Id" />
                                    <input type="hidden" name="SourceExpectedVersion" value="@inst.Version" />
                                    <div class="mb-2">
                                        <label class="form-label small" for="consolidateTarget-@inst.Id">Target installment</label>
                                        <select class="form-select form-select-sm" id="consolidateTarget-@inst.Id" name="TargetCombined" required>
                                            <option value="">Select target installment...</option>
                                            @foreach (var other in series.Installments.Where(o => o.Id != inst.Id))
                                            {
                                                <option value="@other.Id|@other.Version">#@other.OrderKey: @other.Title</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small d-block">Select copies to move:</label>
                                        @foreach (var copy in inst.Copies)
                                        {
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="checkbox" name="CopyIds" value="@copy.Id" checked id="cons-copy-@copy.Id" />
                                                <label class="form-check-label small" for="cons-copy-@copy.Id">@copy.Title</label>
                                            </div>
                                        }
                                    </div>
                                    <button type="submit" class="btn btn-warning btn-sm">Consolidate selected copies</button>
                                </form>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
