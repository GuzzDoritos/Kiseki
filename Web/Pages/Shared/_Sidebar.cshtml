@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string ActiveFor(string pagePrefix) =>
        currentPage.StartsWith(pagePrefix, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
}

<div class="sidebar-content">
    <a class="app-brand d-none d-lg-flex" asp-page="/Index">
        <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 12 12">
                <rect x="1" y="1.5" width="2.5" height="9" rx=".5"></rect>
                <rect x="4.75" y="1.5" width="2.5" height="9" rx=".5"></rect>
                <rect x="8.5" y="1.5" width="2.5" height="9" rx=".5" opacity=".55"></rect>
            </svg>
        </span>
        <span>ImmersionTracker</span>
    </a>

    <nav class="app-nav" aria-label="Primary navigation">
        <a class="app-nav-link @ActiveFor("/Index")" asp-page="/Index">
            <svg class="nav-symbol" aria-hidden="true" viewBox="0 0 16 16">
                <rect x="2" y="2" width="5" height="5" rx="1"></rect>
                <rect x="9" y="2" width="5" height="5" rx="1"></rect>
                <rect x="2" y="9" width="5" height="5" rx="1"></rect>
                <rect x="9" y="9" width="5" height="5" rx="1"></rect>
            </svg>
            <span>Dashboard</span>
        </a>
        <a class="app-nav-link @ActiveFor("/Library")" asp-page="/Library/Index">
            <svg class="nav-symbol" aria-hidden="true" viewBox="0 0 16 16">
                <path d="M3 2.25h3.25v11.5H3zM7.5 2.25h3.25v11.5H7.5zM12 3.25h1.75v10.5H12z"></path>
            </svg>
            <span>Library</span>
        </a>
        <a class="app-nav-link @ActiveFor("/Series")" asp-page="/Series/Index">
            <svg class="nav-symbol nav-symbol-stroke" aria-hidden="true" viewBox="0 0 16 16">
                <circle cx="8" cy="3.5" r="1.5"></circle>
                <circle cx="3.5" cy="12" r="1.5"></circle>
                <circle cx="12.5" cy="12" r="1.5"></circle>
                <path d="M8 5v3.5M8 8.5 3.5 10.5M8 8.5l4.5 2"></path>
            </svg>
            <span>Series</span>
        </a>
    </nav>

    <nav class="app-nav app-nav-bottom" aria-label="Secondary navigation">
        <a class="app-nav-link @ActiveFor("/Import")" asp-page="/Import/Index">
            <svg class="nav-symbol nav-symbol-stroke" aria-hidden="true" viewBox="0 0 16 16">
                <path d="M8 2v9M5.5 8 8 11l2.5-3M2.5 13h11"></path>
            </svg>
            <span>Import</span>
        </a>
    </nav>
</div>
