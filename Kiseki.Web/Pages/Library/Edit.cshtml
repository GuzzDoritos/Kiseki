@page "{id:guid}"
@model Kiseki.Web.Pages.Library.EditModel
@{
    ViewData["Title"] = "Edit work";
}

<nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a asp-page="/Library/Index">Library</a>
    <span>/</span>
    <a asp-page="/Library/Details" asp-route-id="@Model.Id">Work details</a>
    <span>/</span>
    <span>Edit</span>
</nav>

<div class="page-header compact">
    <div><p class="eyebrow">Library entry</p><h1>Edit work</h1></div>
</div>

<section class="content-card form-card">
    <div class="scaffold-notice">This form is presentation boilerplate. Saving will be enabled when Core services are connected.</div>
    <form method="post">
        <div class="form-stack">
            <div>
                <label class="form-label" asp-for="Input.Title"></label>
                <input class="form-control" asp-for="Input.Title" />
            </div>
            <div>
                <label class="form-label" asp-for="Input.MediaType"></label>
                <select class="form-select" asp-for="Input.MediaType" asp-items="Html.GetEnumSelectList<MediaType>()"></select>
            </div>
            <div>
                <label class="form-label" asp-for="Input.ManualCharacterCount"></label>
                <input class="form-control" asp-for="Input.ManualCharacterCount" />
                <div class="form-text">Leave empty to use the linked Jiten character count.</div>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit" disabled>Save changes</button>
            <a class="btn btn-link" asp-page="/Library/Details" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </form>
</section>
